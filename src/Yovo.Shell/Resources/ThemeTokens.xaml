<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================
         UI Token 统一管理（v5 工作台）
         设计系统：颜色语义 / 字号阶梯 / 4px 间距 / 尺寸 / 复合样式
         禁止在视图内散落硬编码——所有语义值只在此定义。
         ============================================================ -->

    <!-- ===== 颜色（语义化） ===== -->
    <!-- 表面 -->
    <Color x:Key="Color.NavBg">#E9EDF1</Color>
    <Color x:Key="Color.ContentBg">#FBFCFD</Color>
    <Color x:Key="Color.PanelBg">#FFFFFF</Color>
    <Color x:Key="Color.PanelBorder">#C9D2DA</Color>
    <Color x:Key="Color.ListBg">#F7F9FA</Color>
    <Color x:Key="Color.ListBorder">#D5DBE1</Color>
    <!-- 文本 -->
    <Color x:Key="Color.TextPrimary">#1A1A1A</Color>
    <Color x:Key="Color.TextSecondary">#5A5A5A</Color>
    <Color x:Key="Color.TextTertiary">#8A8A8A</Color>
    <!-- 语义状态 -->
    <Color x:Key="Color.Accent">#0F3C74</Color>
    <Color x:Key="Color.AccentBg">#D6E4F7</Color>
    <Color x:Key="Color.Success">#2E7D32</Color>
    <Color x:Key="Color.Error">#C62828</Color>
    <Color x:Key="Color.Warn">#C77700</Color>
    <Color x:Key="Color.Offline">#9E9E9E</Color>
    <Color x:Key="Color.NavHover">#E8EEF6</Color>
    <Color x:Key="Color.Tag">#8A5A00</Color>
    <Color x:Key="Color.Splitter">#B9C2CC</Color>
    <Color x:Key="Color.SplitterHover">#6E7680</Color>
    <Color x:Key="Color.Disabled">#A8A8A8</Color>
    <!-- 信号行（崩溃/ANR 等）整行强调背景 -->
    <Color x:Key="Color.SignalBg">#FDEBEA</Color>

    <!-- ===== Brush ===== -->
    <SolidColorBrush x:Key="Brush.NavBg" Color="{StaticResource Color.NavBg}"/>
    <SolidColorBrush x:Key="Brush.ContentBg" Color="{StaticResource Color.ContentBg}"/>
    <SolidColorBrush x:Key="Brush.PanelBg" Color="{StaticResource Color.PanelBg}"/>
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="{StaticResource Color.PanelBorder}"/>
    <SolidColorBrush x:Key="Brush.ListBg" Color="{StaticResource Color.ListBg}"/>
    <SolidColorBrush x:Key="Brush.ListBorder" Color="{StaticResource Color.ListBorder}"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentBg" Color="{StaticResource Color.AccentBg}"/>
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}"/>
    <SolidColorBrush x:Key="Brush.Warn" Color="{StaticResource Color.Warn}"/>
    <SolidColorBrush x:Key="Brush.Offline" Color="{StaticResource Color.Offline}"/>
    <SolidColorBrush x:Key="Brush.NavHover" Color="{StaticResource Color.NavHover}"/>
    <SolidColorBrush x:Key="Brush.Tag" Color="{StaticResource Color.Tag}"/>
    <SolidColorBrush x:Key="Brush.Splitter" Color="{StaticResource Color.Splitter}"/>
    <SolidColorBrush x:Key="Brush.SplitterHover" Color="{StaticResource Color.SplitterHover}"/>
    <SolidColorBrush x:Key="Brush.Disabled" Color="{StaticResource Color.Disabled}"/>
    <SolidColorBrush x:Key="Brush.SignalBg" Color="{StaticResource Color.SignalBg}"/>

    <!-- ===== 字号阶梯（语义化，中文产线） ===== -->
    <FontFamily x:Key="Font.Family">Microsoft YaHei</FontFamily>
    <FontFamily x:Key="Font.Family.Mono">Consolas</FontFamily>
    <sys:Double x:Key="Font.Size.Caption">11</sys:Double>
    <sys:Double x:Key="Font.Size.Body">13</sys:Double>
    <sys:Double x:Key="Font.Size.BodyStrong">14</sys:Double>
    <sys:Double x:Key="Font.Size.Subtitle">17</sys:Double>
    <sys:Double x:Key="Font.Size.PageTitle">20</sys:Double>

    <!-- ===== 间距（4px 基准） ===== -->
    <Thickness x:Key="Space.None">0</Thickness>
    <Thickness x:Key="Space.Xs">4</Thickness>
    <Thickness x:Key="Space.Sm">8</Thickness>
    <Thickness x:Key="Space.Md">12</Thickness>
    <Thickness x:Key="Space.Lg">16</Thickness>
    <Thickness x:Key="Space.Xl">24</Thickness>

    <!-- ===== 尺寸 =====
         列宽（ColumnDefinition.Width）用 GridLength；
         最小/最大宽（MinWidth/MaxWidth 为 double）与控件高度用 double。
         StaticResource 不做类型转换，类型必须匹配目标属性。 -->
    <GridLength x:Key="Size.ShellNav">232</GridLength>
    <GridLength x:Key="Size.LeftPanel">290</GridLength>
    <sys:Double x:Key="Size.LeftPanelMin">240</sys:Double>
    <GridLength x:Key="Size.InputPanel">280</GridLength>
    <sys:Double x:Key="Size.InputPanelMin">220</sys:Double>
    <sys:Double x:Key="Size.InputPanelMax">440</sys:Double>
    <sys:Double x:Key="Size.LogPanelMin">340</sys:Double>
    <GridLength x:Key="Size.FormLabelCol">84</GridLength>
    <GridLength x:Key="Size.FormInputCol">280</GridLength>
    <GridLength x:Key="Size.ListPanel">250</GridLength>
    <sys:Double x:Key="Size.InputHeight">30</sys:Double>
    <sys:Double x:Key="Size.RowHeight">30</sys:Double>
    <!-- 设备列表高度上限（多设备不挤压导航，P1-4） -->
    <sys:Double x:Key="Size.DeviceListMax">220</sys:Double>

    <!-- ===== 面板/列边距 ===== -->
    <Thickness x:Key="Padding.Panel">14,12</Thickness>
    <Thickness x:Key="Padding.Page">14,10,14,14</Thickness>
    <Thickness x:Key="Margin.ColumnLeft">0,0,12,0</Thickness>
    <Thickness x:Key="Margin.ColumnMid">12,0,12,0</Thickness>
    <Thickness x:Key="Margin.ColumnRight">12,0,0,0</Thickness>
    <Thickness x:Key="Margin.Toolbar">0,0,0,12</Thickness>

    <!-- ===== 圆角/边框 ===== -->
    <CornerRadius x:Key="Radius.Sm">4</CornerRadius>
    <CornerRadius x:Key="Radius.Md">6</CornerRadius>
    <Thickness x:Key="Border.Panel">1</Thickness>

    <!-- ============================================================
         复合样式（全局，禁止视图内遮蔽同名样式）
         ============================================================ -->

    <!-- 页面标题（设置页等） -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.PageTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    </Style>

    <!-- 面板标题（管理窗口等） -->
    <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Subtitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    </Style>

    <!-- 分区标题（面板内分组） -->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.BodyStrong}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- 字段标签（表单） -->
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 输入框（表单统一） -->
    <Style x:Key="InputBoxStyle" TargetType="ui:TextBox">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="Height" Value="{StaticResource Size.InputHeight}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- 日志等宽文本 -->
    <Style x:Key="LogMonoStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Mono}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
    </Style>

    <!-- 卡片表面 -->
    <Style x:Key="PanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.PanelBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Border.Panel}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
        <Setter Property="Padding" Value="{StaticResource Padding.Panel}"/>
    </Style>

    <!-- 导航列表项 -->
    <Style x:Key="NavListItemStyle" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="10,2"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.AccentBg}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.NavHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 通用列表项（命令/组/设备统一选中态 — P0-5 对比度修复） -->
    <Style x:Key="ListItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.AccentBg}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.NavHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- DataGrid 行选中态（P1-6 与 Shell 导航一致） -->
    <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.AccentBg}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 分界线 -->
    <Style x:Key="SplitterStyle" TargetType="GridSplitter">
        <Setter Property="Width" Value="2"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
        <Setter Property="Background" Value="{StaticResource Brush.Splitter}"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.SplitterHover}"/>
                <Setter Property="Width" Value="3"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
