<ui:FluentWindow x:Class="Yovo.Shell.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:beh="clr-namespace:Yovo.Shell.Behaviors"
        xmlns:conv="clr-namespace:Yovo.Shell.Converters"
        FontFamily="{StaticResource Font.Family}"
        Title="Yovo ADB Tools"
        Width="1200" Height="740"
        MinHeight="560" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <conv:BoolToSelectionModeConverter x:Key="BoolToSelectionMode"/>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource Size.ShellNav}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======== 官方 TitleBar ======== -->
        <ui:TitleBar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                     Title="Yovo ADB Tools"
                     Icon="pack://application:,,,/Yovo.Shell;component/Resources/app.ico"/>

        <!-- ======== 左侧：设备栏（可折叠）+ 模块导航 ======== -->
        <Border Grid.Row="1" Grid.Column="0"
                ClipToBounds="True"
                Background="{StaticResource Brush.NavBg}"
                BorderBrush="{StaticResource Brush.PanelBorder}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="0,8,0,0">

                <!-- 设备区（标题行可折叠；DataContext 下移到面板 — 避免导航绑定错 VM） -->
                <StackPanel DockPanel.Dock="Top" Margin="12,0,12,12"
                            DataContext="{Binding DeviceRail}">
                    <!-- 标题行：折叠(右)→刷新(右)→标题(填充) — P1-1 折叠贴刷新左侧 -->
                    <DockPanel Margin="0,0,0,6">
                        <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsDevicesExpanded}"
                                      Content="&#xE76C;" Width="22" Height="22"
                                      Margin="0,0,4,0" Cursor="Hand"
                                      FontFamily="Segoe MDL2 Assets"
                                      ToolTip="折叠/展开设备列表"
                                      Background="Transparent" BorderThickness="0"/>
                        <ui:Button DockPanel.Dock="Right" Content="刷新" FontSize="{StaticResource Font.Size.Caption}"
                                   Appearance="Secondary" Command="{Binding RefreshCommand}"
                                   Cursor="Hand" Padding="8,3" Height="24"/>
                        <TextBlock Text="设备" FontSize="{StaticResource Font.Size.Body}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Devices}"
                             SelectionMode="{Binding IsMultiSelectEnabled, Converter={StaticResource BoolToSelectionMode}}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MaxHeight="{StaticResource Size.DeviceListMax}"
                             BorderBrush="{StaticResource Brush.ListBorder}" BorderThickness="1"
                             Background="{StaticResource Brush.ListBg}"
                             beh:SelectedItemsBehavior.SelectedItems="{Binding SelectedDevices}"
                             Visibility="{Binding IsDevicesExpanded, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItemStyle}"/>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                             DockPanel.Dock="Left"
                                             VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Brush.Offline}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Brush.Success}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Model}" FontSize="{StaticResource Font.Size.Body}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Serial}" FontSize="{StaticResource Font.Size.Caption}"
                                                   Foreground="{StaticResource Brush.TextTertiary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- 模块导航 -->
                <StackPanel DockPanel.Dock="Top" Margin="20,0,16,4">
                    <TextBlock Text="模块" FontSize="{StaticResource Font.Size.Body}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavListItemStyle}"/>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding IconGlyph}" FontSize="15"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"/>
                                <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Border Background="{StaticResource Brush.Offline}" CornerRadius="6"
                                        Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsPlanned, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="开发中" FontSize="10"
                                               Foreground="White" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ======== 右侧：内容宿主（当前模块视图） ======== -->
        <Grid Grid.Row="1" Grid.Column="1"
              Background="{StaticResource Brush.ContentBg}">
            <ContentControl x:Name="ContentHost"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </Grid>

        <!-- ======== 底部状态栏（P0-3：设备状态靠右，版本号填充） ======== -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Padding="14,5" BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource Brush.PanelBorder}"
                Background="{StaticResource Brush.NavBg}">
            <DockPanel>
                <!-- 右侧：后台任务 + 设备状态（先声明 Dock=Right → 靠右） -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusBar.BackgroundSummary}"
                               FontSize="{StaticResource Font.Size.Caption}"
                               Foreground="{StaticResource Brush.Warn}"
                               Margin="0,0,16,0" VerticalAlignment="Center"
                               Visibility="{Binding StatusBar.BackgroundSummary, Converter={StaticResource NullToCollapsed}}"/>
                    <TextBlock Text="设备: " FontSize="{StaticResource Font.Size.Caption}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextSecondary}"/>
                    <TextBlock Text="{Binding DeviceRail.StatusText}"
                               FontSize="{StaticResource Font.Size.Caption}"
                               FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Success}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeviceRail.IsRefreshing}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Warn}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DeviceRail.StatusText}" Value="设备扫描失败">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Error}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <!-- 版本号（末子填充） -->
                <TextBlock Text="{Binding StatusBar.VersionText}"
                           FontSize="{StaticResource Font.Size.Caption}"
                           Foreground="{StaticResource Brush.TextTertiary}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
