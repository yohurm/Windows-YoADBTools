<UserControl x:Class="Yovo.Shell.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="{StaticResource Font.Family}">

    <!-- 设置面板 — 必要项：工具链 + 日志分析运行参数 -->
    <Grid Margin="{StaticResource Padding.Page}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">

                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="仅保留产线常用项：ADB / 数据目录 / 日志分析缓冲与显示"
                           FontSize="{StaticResource Font.Size.Body}"
                           Foreground="{StaticResource Brush.TextTertiary}" Margin="0,4,0,0"/>

                <!-- 工具链 -->
                <TextBlock Text="工具链" Style="{StaticResource SectionTitleStyle}" Margin="0,20,0,8"/>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="ADB 路径" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,3"/>
                        <TextBlock Text="留空自动解析：应用目录 tools → 内置 ADB 解压。保存后立即生效。"
                                   FontSize="{StaticResource Font.Size.Caption}"
                                   Foreground="{StaticResource Brush.TextTertiary}"
                                   TextWrapping="Wrap"/>
                        <DockPanel Margin="0,10,0,0">
                            <ui:Button DockPanel.Dock="Right" Content="浏览…" Appearance="Secondary"
                                       Margin="8,0,0,0" Padding="10,3" Height="30"
                                       Command="{Binding BrowseAdbPathCommand}"/>
                            <ui:TextBox Text="{Binding AdbPath}"
                                        Style="{StaticResource InputBoxStyle}"
                                        ToolTip="adb.exe 或所在目录；留空自动解析"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="数据目录" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,3"/>
                        <TextBlock Text="命令库 / ADB / 模块数据存放位置。留空为默认。保存后重启应用生效。"
                                   FontSize="{StaticResource Font.Size.Caption}"
                                   Foreground="{StaticResource Brush.TextTertiary}"
                                   TextWrapping="Wrap"/>
                        <DockPanel Margin="0,10,0,0">
                            <ui:Button DockPanel.Dock="Right" Content="浏览…" Appearance="Secondary"
                                       Margin="8,0,0,0" Padding="10,3" Height="30"
                                       Command="{Binding BrowseDataDirCommand}"/>
                            <ui:TextBox Text="{Binding DataDir}"
                                        Style="{StaticResource InputBoxStyle}"
                                        ToolTip="默认 %LOCALAPPDATA%\YovoAdbTools\data；留空恢复默认"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- 日志分析 -->
                <TextBlock Text="日志分析" Style="{StaticResource SectionTitleStyle}" Margin="0,24,0,8"/>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="环形缓冲行数" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,3"/>
                        <TextBlock Text="内存中保留的 logcat 行数（1000–500000）。过大占用内存，过小易丢历史。"
                                   FontSize="{StaticResource Font.Size.Caption}"
                                   Foreground="{StaticResource Brush.TextTertiary}"
                                   TextWrapping="Wrap"/>
                        <ui:TextBox Text="{Binding LogBufferCapacity}"
                                    Style="{StaticResource InputBoxStyle}" Margin="0,10,0,0"
                                    ToolTip="默认 50000"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="界面显示行数" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,3"/>
                        <TextBlock Text="列表可见行上限（500–50000）。超出裁剪最旧行；缓冲仍可导出全量过滤结果。重启模块后生效。"
                                   FontSize="{StaticResource Font.Size.Caption}"
                                   Foreground="{StaticResource Brush.TextTertiary}"
                                   TextWrapping="Wrap"/>
                        <ui:TextBox Text="{Binding LogDisplayLimit}"
                                    Style="{StaticResource InputBoxStyle}" Margin="0,10,0,0"
                                    ToolTip="默认 2000"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}" Margin="0,12,0,0">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding LogClearDeviceOnStart}"
                                  Content="开始采集前清空设备 log 缓冲（adb logcat -c）"
                                  FontSize="{StaticResource Font.Size.Body}"/>
                        <TextBlock Text="勾选后每次「开始采集」先清设备侧缓冲，避免旧日志干扰；产线复现问题前常用。"
                                   FontSize="{StaticResource Font.Size.Caption}"
                                   Foreground="{StaticResource Brush.TextTertiary}"
                                   TextWrapping="Wrap" Margin="24,6,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Message}"
                           FontSize="{StaticResource Font.Size.Body}"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           TextWrapping="Wrap" Margin="0,12,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <ui:Button Content="恢复默认" Appearance="Secondary"
                               Margin="0,0,10,0" Command="{Binding RestoreDefaultsCommand}"/>
                    <ui:Button Content="保存" Appearance="Primary" Width="96"
                               Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
