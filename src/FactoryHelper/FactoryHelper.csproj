<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FactoryHelper</AssemblyName>
    <RootNamespace>FactoryHelper</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Yovo ADB Tools</Product>
    <Description>Yovo ADB Tools — 多模块桌面工具平台，基于 ADB 的轻量化工具集</Description>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

  <!-- 内置 ADB 二进制（打包进 exe，运行时解压） -->
  <ItemGroup>
    <EmbeddedResource Include="Tools\adb.exe" LogicalName="FactoryHelper.Tools.adb.exe" />
    <EmbeddedResource Include="Tools\AdbWinApi.dll" LogicalName="FactoryHelper.Tools.AdbWinApi.dll" />
    <EmbeddedResource Include="Tools\AdbWinUsbApi.dll" LogicalName="FactoryHelper.Tools.AdbWinUsbApi.dll" />
  </ItemGroup>

  <!-- 发布配置：单文件自包含 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
