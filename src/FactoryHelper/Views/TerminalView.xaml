<UserControl x:Class="FactoryHelper.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:FactoryHelper.Converters"
             FontFamily="Microsoft YaHei">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======== 工具栏 ======== -->
        <Border Grid.Row="0" Padding="12,8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource DividerStrokeColorDefault}">
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="刷新设备" Command="{Binding RefreshDevicesCommand}"
                           Appearance="Secondary" Margin="0,0,10,0" Icon="FluentRefresh24"/>
                <ui:Button Content="命令管理" Command="{Binding OpenCommandManagerCommand}"
                           Appearance="Secondary" Margin="0,0,10,0" Icon="FluentSettings24"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           FontSize="13" Foreground="{DynamicResource TextFillColorSecondary}"/>
            </StackPanel>
        </Border>

        <!-- ======== 主内容区（三栏可拖拽） ======== -->
        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="260" MinWidth="200" MaxWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧：设备 + 命令 ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 设备列表 -->
                <Border Grid.Row="0" Padding="12,10" BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource DividerStrokeColorDefault}">
                    <StackPanel>
                        <TextBlock Text="设备列表" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <ListBox Name="DeviceListBox" ItemsSource="{Binding Devices}"
                                 SelectionMode="Extended" Height="110"
                                 DisplayMemberPath="DisplayName"
                                 Background="{DynamicResource ControlFillColorDefault}"
                                 BorderBrush="{DynamicResource ControlStrokeColorDefault}"
                                 BorderThickness="1"/>
                        <TextBlock Text="提示: 按住 Ctrl 多选设备" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 命令/命令组 -->
                <TabControl Grid.Row="1" Margin="0" Padding="0"
                            Background="Transparent" BorderThickness="0">
                    <TabItem Header="单条命令" Padding="12,8">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <ComboBox Grid.Row="0" ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      Margin="0,0,0,8"/>

                            <ListBox Grid.Row="1" ItemsSource="{Binding Commands}"
                                     SelectedItem="{Binding SelectedCommand}"
                                     Background="{DynamicResource ControlFillColorDefault}"
                                     BorderBrush="{DynamicResource ControlStrokeColorDefault}"
                                     BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,3">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="[输入]" FontSize="10" FontWeight="Bold"
                                                           Foreground="#c8511c" VerticalAlignment="Center"
                                                           Visibility="{Binding RequiresInput, Converter={StaticResource BoolToVisibility}}"
                                                           Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DisplayCommand}" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondary}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="命令组" Padding="12,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <ComboBox Grid.Row="0" ItemsSource="{Binding GroupCategories}"
                                      SelectedItem="{Binding SelectedGroupCategory}"
                                      Margin="0,0,0,8"/>

                            <ListBox Grid.Row="1" ItemsSource="{Binding CommandGroups}"
                                     SelectedItem="{Binding SelectedGroup}"
                                     Background="{DynamicResource ControlFillColorDefault}"
                                     BorderBrush="{DynamicResource ControlStrokeColorDefault}"
                                     BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,3">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Category}" FontSize="10"
                                                           Foreground="#8a5a00" FontWeight="Bold"
                                                           Margin="0,0,6,0"
                                                           Visibility="{Binding Category, Converter={StaticResource NullToCollapsed}}"/>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondary}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Steps.Count, StringFormat={}{0} 步}" FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorTertiary}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- 分隔条 1 -->
            <GridSplitter Grid.Column="1" Width="5" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          Background="Transparent"
                          HorizontalAlignment="Center"
                          ShowsPreview="False"/>

            <!-- ===== 中间：日志 + 执行 ===== -->
            <Grid Grid.Column="2" Margin="10,8,10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button Content="执行命令" Command="{Binding ExecuteCommandCommand}"
                               Appearance="Primary" Margin="0,0,10,0" Icon="FluentPlay24"/>
                    <ui:Button Content="执行命令组" Command="{Binding ExecuteGroupCommand}"
                               Appearance="Primary" Margin="0,0,10,0" Icon="FluentPlayCircle24"/>
                    <ui:Button Content="清空日志" Command="{Binding ClearLogCommand}"
                               Appearance="Secondary" Icon="FluentDelete24"/>
                </StackPanel>

                <!-- 日志输出 -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource ControlStrokeColorDefault}"
                        BorderThickness="1" CornerRadius="4">
                    <ScrollViewer Name="LogScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <TextBox Name="LogTextBox" IsReadOnly="True" TextWrapping="Wrap"
                                 BorderThickness="0" Padding="8,6"
                                 FontFamily="Consolas" FontSize="12"
                                 Background="{DynamicResource ControlFillColorDefault}"/>
                    </ScrollViewer>
                </Border>

                <!-- 底部状态 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                    <ProgressBar Name="BusyProgressBar" Width="100" Height="6"
                                 IsIndeterminate="{Binding IsBusy}"
                                 Visibility="Collapsed"
                                 Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- 分隔条 2 -->
            <GridSplitter Grid.Column="3" Width="5" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          Background="Transparent"
                          HorizontalAlignment="Center"
                          ShowsPreview="False"/>

            <!-- ===== 右侧：参数输入区（常驻展开） ===== -->
            <Grid Grid.Column="4" Margin="0,8,10,8">
                <Border Background="{DynamicResource ControlFillColorSecondary}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefault}"
                        BorderThickness="1" CornerRadius="4" Padding="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="参数输入" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimary}" Margin="0,0,0,8"/>

                        <!-- 有输入项：显示输入框 -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasInputPanel, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding ActiveInputs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding GroupLabel}" FontSize="11" FontWeight="Bold"
                                                       Foreground="#8a5a00" Margin="0,0,0,2"
                                                       Visibility="{Binding HasGroupLabel, Converter={StaticResource BoolToVisibility}}"/>
                                            <TextBlock Text="{Binding Label}" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondary}" Margin="0,0,0,3"/>
                                            <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                        FontSize="13" MinHeight="30"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 无输入项：占位提示（面板常驻） -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasInputPanel, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="选择需要输入的命令" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorTertiary}"
                                       TextAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="参数输入框将显示在此处" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiary}"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>