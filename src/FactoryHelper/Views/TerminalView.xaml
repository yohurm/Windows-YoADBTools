<UserControl x:Class="FactoryHelper.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FactoryHelper.Converters"
             FontFamily="Microsoft YaHei">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======== 工具栏 ======== -->
        <Border Grid.Row="0" Background="#f0f0f0" Padding="10,8" BorderBrush="#d0d0d0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="刷新设备" Command="{Binding RefreshDevicesCommand}"
                        Width="80" Margin="0,0,10,0" Height="28"/>
                <Button Content="命令管理" Command="{Binding OpenCommandManagerCommand}"
                        Width="80" Margin="0,0,10,0" Height="28"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           Foreground="#555" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- ======== 主内容区 ======== -->
        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧面板：设备列表 + 命令/命令组 ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 设备列表 -->
                <Border Grid.Row="0" BorderBrush="#d0d0d0" BorderThickness="0,0,0,1" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="设备列表" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                        <ListBox Name="DeviceListBox" ItemsSource="{Binding Devices}"
                                 SelectionMode="Extended" Height="120"
                                 DisplayMemberPath="DisplayName"
                                 BorderBrush="#ccc" BorderThickness="1"/>
                        <TextBlock Text="提示: 按住 Ctrl 多选设备" FontSize="11"
                                   Foreground="#888" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 命令/命令组标签页 -->
                <TabControl Grid.Row="1" Margin="0" Padding="0">
                    <TabItem Header="单条命令">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <ComboBox Grid.Row="0" ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      Margin="8,6,8,4" Height="26"/>

                            <ListBox Grid.Row="1" ItemsSource="{Binding Commands}"
                                     SelectedItem="{Binding SelectedCommand}"
                                     Margin="8,0,8,8"
                                     BorderBrush="#ccc" BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2" Orientation="Horizontal">
                                            <TextBlock Text="[输入]" FontSize="10" FontWeight="Bold"
                                                       Foreground="#c8511c" VerticalAlignment="Center"
                                                       Visibility="{Binding RequiresInput, Converter={StaticResource BoolToVisibility}}"
                                                       Margin="0,0,4,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding DisplayCommand}" FontSize="11"
                                                           Foreground="#666" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="命令组">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <ComboBox Grid.Row="0" ItemsSource="{Binding GroupCategories}"
                                      SelectedItem="{Binding SelectedGroupCategory}"
                                      Margin="8,6,8,4" Height="26"/>

                            <ListBox Grid.Row="1" ItemsSource="{Binding CommandGroups}"
                                     SelectedItem="{Binding SelectedGroup}"
                                     Margin="8,0,8,8"
                                     BorderBrush="#ccc" BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Category}" FontSize="10"
                                                           Foreground="#8a5a00" FontWeight="Bold"
                                                           Margin="0,0,6,0"
                                                           Visibility="{Binding Category, Converter={StaticResource NullToCollapsed}}"/>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="11"
                                                       Foreground="#666" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Steps.Count, StringFormat={}{0} 步}" FontSize="10"
                                                       Foreground="#888"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- ===== 右侧面板：日志 + 执行按钮 ===== -->
            <Grid Grid.Column="1" Margin="10,8,10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="执行命令" Command="{Binding ExecuteCommandCommand}"
                            Width="90" Height="32" Margin="0,0,10,0"
                            Background="#0078d4" Foreground="White"
                            FontWeight="Bold" BorderThickness="0"/>
                    <Button Content="执行命令组" Command="{Binding ExecuteGroupCommand}"
                            Width="100" Height="32" Margin="0,0,10,0"
                            Background="#107c10" Foreground="White"
                            FontWeight="Bold" BorderThickness="0"/>
                    <Button Content="清空日志" Command="{Binding ClearLogCommand}"
                            Width="80" Height="32"/>
                </StackPanel>

                <!-- 日志输出 -->
                <Border Grid.Row="1" BorderBrush="#ccc" BorderThickness="1">
                    <ScrollViewer Name="LogScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <TextBox Name="LogTextBox" IsReadOnly="True" TextWrapping="Wrap"
                                 BorderThickness="0" Padding="8,6"
                                 FontFamily="Consolas" FontSize="12"
                                 Background="White"/>
                    </ScrollViewer>
                </Border>

                <!-- 底部状态 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                    <ProgressBar Name="BusyProgressBar" Width="100" Height="6"
                                 IsIndeterminate="{Binding IsBusy}"
                                 Visibility="Collapsed"
                                 Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#555"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- ===== 右侧列：统一参数输入区 ===== -->
            <Border Grid.Column="2" Background="#fff8ec"
                    BorderBrush="#e0c98a" BorderThickness="1"
                    Margin="10,8,10,8" Padding="10"
                    Visibility="{Binding HasInputPanel, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="参数输入" FontSize="14" FontWeight="Bold"
                               Foreground="#8a5a00" Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ActiveInputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding GroupLabel}" FontSize="11" FontWeight="Bold"
                                                   Foreground="#8a5a00" Margin="0,0,0,2"
                                                   Visibility="{Binding HasGroupLabel, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Text="{Binding Label}" FontSize="11"
                                                   Foreground="#666" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="13" Padding="4,2" MinHeight="28"
                                                 BorderBrush="#ccc" BorderThickness="1"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>