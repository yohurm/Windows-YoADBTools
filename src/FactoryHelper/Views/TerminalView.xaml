<UserControl x:Class="FactoryHelper.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:FactoryHelper.Converters"
             FontFamily="Microsoft YaHei">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed"/>
    </UserControl.Resources>

    <!--
      布局架构 v2 — 统一间距体系:
      - 页面边距 14,10,14,14 (Padding.Page)
      - 列间距: 分界线两侧内容统一 12px (ColumnLeft/Mid/Right)
      - 面板间距: 垂直 10px (PanelGap)
      - 输入面板列: 动态宽度 (有输入 280 / 无输入 0)，由 Code-behind 切换，
        日志列 Star 自动填充回收空间
    -->
    <Grid Margin="{StaticResource Padding.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======== 工具栏 ======== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="{StaticResource Margin.Toolbar}">
            <ui:Button Content="刷新设备" Command="{Binding RefreshDevicesCommand}"
                       Appearance="Secondary" Margin="0,0,10,0" Icon="FluentRefresh24"/>
            <ui:Button Content="命令管理" Command="{Binding OpenCommandManagerCommand}"
                       Appearance="Secondary" Margin="0,0,10,0" Icon="FluentSettings24"/>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                       FontSize="{StaticResource Font.Size.Md}"
                       Foreground="{StaticResource Brush.TextSecondary}"/>
        </StackPanel>

        <!-- ======== 三栏主布局 ======== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColLeft" Width="290" MinWidth="240"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="ColLog" Width="*" MinWidth="340"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="ColInput" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左栏：设备 + 命令（距分界线 12px） ===== -->
            <Grid Grid.Column="0" Margin="{StaticResource Margin.ColumnLeft}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 设备面板 -->
                <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Margin="{StaticResource Margin.PanelGap}">
                    <StackPanel>
                        <TextBlock Text="设备列表" Style="{StaticResource SectionTitleStyle}"/>
                        <ListBox Name="DeviceListBox" ItemsSource="{Binding Devices}"
                                 SelectionMode="Extended" Height="96"
                                 DisplayMemberPath="DisplayName"
                                 BorderBrush="{StaticResource Brush.ListBorder}" BorderThickness="1"
                                 Background="{StaticResource Brush.ListBg}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock Text="提示: 按住 Ctrl 多选设备" FontSize="11"
                                   Foreground="{StaticResource Brush.TextTertiary}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 单条命令面板 -->
                <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Margin="{StaticResource Margin.PanelGap}">
                    <StackPanel>
                        <TextBlock Text="单条命令" Style="{StaticResource SectionTitleStyle}"/>
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding Commands}"
                                 SelectedItem="{Binding SelectedCommand}"
                                 Height="140"
                                 BorderBrush="{StaticResource Brush.ListBorder}" BorderThickness="1"
                                 Background="{StaticResource Brush.ListBg}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="[输入]" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource Brush.Warning}" VerticalAlignment="Center"
                                                       Visibility="{Binding RequiresInput, Converter={StaticResource BoolToVisibility}}"
                                                       Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DisplayCommand}" FontSize="11"
                                                   Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- 命令组面板 -->
                <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="命令组" Style="{StaticResource SectionTitleStyle}"/>
                        <ComboBox ItemsSource="{Binding GroupCategories}"
                                  SelectedItem="{Binding SelectedGroupCategory}"
                                  Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding CommandGroups}"
                                 SelectedItem="{Binding SelectedGroup}"
                                 BorderBrush="{StaticResource Brush.ListBorder}" BorderThickness="1"
                                 Background="{StaticResource Brush.ListBg}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Category}" FontSize="10"
                                                       Foreground="{StaticResource Brush.Tag}" FontWeight="Bold"
                                                       Margin="0,0,6,0"
                                                       Visibility="{Binding Category, Converter={StaticResource NullToCollapsed}}"/>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Steps.Count, StringFormat={}{0} 步}" FontSize="10"
                                                   Foreground="{StaticResource Brush.TextTertiary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 分隔条 1 -->
            <GridSplitter Grid.Column="1" Style="{StaticResource SplitterStyle}"/>

            <!-- ===== 中栏：执行 + 日志（两侧距分界线 12px） ===== -->
            <Grid Grid.Column="2" Margin="{StaticResource Margin.ColumnMid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <ui:Button Content="执行命令" Command="{Binding ExecuteCommandCommand}"
                               Appearance="Primary" Margin="0,0,10,0" Icon="FluentPlay24"/>
                    <ui:Button Content="执行命令组" Command="{Binding ExecuteGroupCommand}"
                               Appearance="Primary" Margin="0,0,10,0" Icon="FluentPlayCircle24"/>
                    <ui:Button Content="清空日志" Command="{Binding ClearLogCommand}"
                               Appearance="Secondary" Icon="FluentDelete24"/>
                </StackPanel>

                <!-- 日志面板 -->
                <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Padding="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="执行日志" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}" Margin="14,12,14,8"/>
                        <Border BorderBrush="{StaticResource Brush.ListBorder}" BorderThickness="0,1,0,0">
                            <ScrollViewer Name="LogScroll" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBox Name="LogTextBox" IsReadOnly="True" TextWrapping="Wrap"
                                         BorderThickness="0" Padding="12,8"
                                         FontFamily="Consolas" FontSize="12"
                                         Background="Transparent"/>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- 底部状态 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <ProgressBar Name="BusyProgressBar" Width="100" Height="6"
                                 IsIndeterminate="{Binding IsBusy}"
                                 Visibility="Collapsed"
                                 Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- 分隔条 2 -->
            <GridSplitter Grid.Column="3" Style="{StaticResource SplitterStyle}"/>

            <!-- ===== 右栏：参数输入（动态列宽，距分界线 12px） ===== -->
            <Grid Grid.Column="4" Margin="{StaticResource Margin.ColumnRight}">
                <Border Style="{StaticResource PanelBorderStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="参数输入" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ActiveInputs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding GroupLabel}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource Brush.Tag}" Margin="0,0,0,2"
                                                       Visibility="{Binding HasGroupLabel, Converter={StaticResource BoolToVisibility}}"/>
                                            <TextBlock Text="{Binding Label}" FontSize="11"
                                                       Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,3"/>
                                            <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                        FontSize="13" MinHeight="30"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>