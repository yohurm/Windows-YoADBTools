<UserControl x:Class="FactoryHelper.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:FactoryHelper.Converters"
             FontFamily="Microsoft YaHei">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <!-- 分区标题样式 -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- 拖拽分界线样式：默认淡灰细线，悬停高亮 -->
        <Style x:Key="SplitterStyle" TargetType="GridSplitter">
            <Setter Property="Width" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlStrokeColorPrimaryBrush}"/>
                    <Setter Property="Width" Value="6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,8,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======== 工具栏 ======== -->
        <Border Grid.Row="0" Padding="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="刷新设备" Command="{Binding RefreshDevicesCommand}"
                           Appearance="Secondary" Margin="0,0,10,0" Icon="FluentRefresh24"/>
                <ui:Button Content="命令管理" Command="{Binding OpenCommandManagerCommand}"
                           Appearance="Secondary" Margin="0,0,10,0" Icon="FluentSettings24"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- ======== 三栏主布局（可拖拽分栏） ======== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="340"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280" MinWidth="220" MaxWidth="440"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左栏：设备 + 命令（卡片分组） ===== -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 设备卡片 -->
                <ui:Card Grid.Row="0" Margin="0,0,0,10" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="设备列表" Style="{StaticResource SectionTitleStyle}"/>
                        <ListBox Name="DeviceListBox" ItemsSource="{Binding Devices}"
                                 SelectionMode="Extended" Height="100"
                                 DisplayMemberPath="DisplayName"
                                 BorderThickness="0"
                                 Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock Text="提示: 按住 Ctrl 多选设备" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- 命令分类筛选 -->
                <ui:Card Grid.Row="1" Margin="0,0,0,10" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="单条命令" Style="{StaticResource SectionTitleStyle}"/>
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding Commands}"
                                 SelectedItem="{Binding SelectedCommand}"
                                 Height="150"
                                 BorderThickness="0"
                                 Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="[输入]" FontSize="10" FontWeight="Bold"
                                                       Foreground="#c8511c" VerticalAlignment="Center"
                                                       Visibility="{Binding RequiresInput, Converter={StaticResource BoolToVisibility}}"
                                                       Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DisplayCommand}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ui:Card>

                <!-- 命令组 -->
                <ui:Card Grid.Row="2" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="命令组" Style="{StaticResource SectionTitleStyle}"/>
                        <ComboBox ItemsSource="{Binding GroupCategories}"
                                  SelectedItem="{Binding SelectedGroupCategory}"
                                  Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding CommandGroups}"
                                 SelectedItem="{Binding SelectedGroup}"
                                 BorderThickness="0"
                                 Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Category}" FontSize="10"
                                                       Foreground="#8a5a00" FontWeight="Bold"
                                                       Margin="0,0,6,0"
                                                       Visibility="{Binding Category, Converter={StaticResource NullToCollapsed}}"/>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Steps.Count, StringFormat={}{0} 步}" FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- 分隔条 1 -->
            <GridSplitter Grid.Column="1" Style="{StaticResource SplitterStyle}"/>

            <!-- ===== 中栏：执行 + 日志 ===== -->
            <Grid Grid.Column="2" Margin="12,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <ui:Button Content="执行命令" Command="{Binding ExecuteCommandCommand}"
                               Appearance="Primary" Margin="0,0,10,0" Icon="FluentPlay24"/>
                    <ui:Button Content="执行命令组" Command="{Binding ExecuteGroupCommand}"
                               Appearance="Primary" Margin="0,0,10,0" Icon="FluentPlayCircle24"/>
                    <ui:Button Content="清空日志" Command="{Binding ClearLogCommand}"
                               Appearance="Secondary" Icon="FluentDelete24"/>
                </StackPanel>

                <!-- 日志卡片 -->
                <ui:Card Grid.Row="1" Padding="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="执行日志" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="14,12,14,8"/>
                        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0">
                            <ScrollViewer Name="LogScroll" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBox Name="LogTextBox" IsReadOnly="True" TextWrapping="Wrap"
                                         BorderThickness="0" Padding="12,8"
                                         FontFamily="Consolas" FontSize="12"
                                         Background="Transparent"/>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </ui:Card>

                <!-- 底部状态 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <ProgressBar Name="BusyProgressBar" Width="100" Height="6"
                                 IsIndeterminate="{Binding IsBusy}"
                                 Visibility="Collapsed"
                                 Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- 分隔条 2 -->
            <GridSplitter Grid.Column="3" Style="{StaticResource SplitterStyle}"/>

            <!-- ===== 右栏：参数输入（常驻卡片） ===== -->
            <ui:Card Grid.Column="4" Padding="14,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="参数输入" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,8"/>

                    <!-- 有输入项：显示输入框 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasInputPanel, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding ActiveInputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding GroupLabel}" FontSize="11" FontWeight="Bold"
                                                   Foreground="#8a5a00" Margin="0,0,0,2"
                                                   Visibility="{Binding HasGroupLabel, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Text="{Binding Label}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                        <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                    FontSize="13" MinHeight="30"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 无输入项：占位提示 -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasInputPanel, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="选择需要输入的命令" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="参数输入框将显示在此处" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>