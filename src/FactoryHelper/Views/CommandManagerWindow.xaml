<Window x:Class="FactoryHelper.Views.CommandManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="命令库管理" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei"
        ShowInTaskbar="False">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部说明 -->
        <TextBlock Grid.Row="0" Text="单条命令管理 — 增删改后点击保存生效"
                   FontSize="13" Foreground="#555" Margin="0,0,0,8"/>

        <!-- 命令编辑表格 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：命令列表 -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock DockPanel.Dock="Top" Text="命令列表" FontWeight="Bold" Margin="0,0,0,4"/>
                <ListBox Name="CmdListBox" ItemsSource="{Binding Commands}"
                         SelectedItem="{Binding SelectedCommand}"
                         DisplayMemberPath="Name"
                         BorderBrush="#ccc" BorderThickness="1"/>
            </DockPanel>

            <!-- 右侧：命令详情编辑 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="名称:" VerticalAlignment="Center" Margin="0,2"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditingCommand.Name}" Margin="0,2" Padding="4,2"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="分类:" VerticalAlignment="Center" Margin="0,2"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditingCommand.Category}" Margin="0,2" Padding="4,2"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="命令:" VerticalAlignment="Center" Margin="0,2"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditingCommand.Command}" Margin="0,2" Padding="4,2"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="超时(ms):" VerticalAlignment="Center" Margin="0,2"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EditingCommand.TimeoutMs}" Margin="0,2" Padding="4,2"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="输入提示:" VerticalAlignment="Top" Margin="0,2"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding EditingCommand.InputPromptsText}"
                         Margin="0,2" Padding="4,2" TextWrapping="Wrap" Height="60"
                         ToolTip="多个提示用逗号分隔，如: 请输入PCBID, 请输入SN"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="描述:" VerticalAlignment="Top" Margin="0,2"/>
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding EditingCommand.Description}"
                         Margin="0,2" Padding="4,2" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>

                <!-- 按钮 -->
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="新增" Width="64" Height="30" Margin="0,0,8,0" Click="OnNewClick"/>
                    <Button Content="删除" Width="64" Height="30" Margin="0,0,8,0" Click="OnDeleteClick"/>
                    <Button Content="保存" Width="72" Height="30" Background="#0078d4"
                            Foreground="White" BorderThickness="0" Click="OnSaveClick"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="2" Text="提示: 需要输入参数的命令，命令中用 {0} {1} 占位；输入提示用逗号分隔"
                   FontSize="11" Foreground="#888" Margin="0,8,0,0"/>
    </Grid>
</Window>