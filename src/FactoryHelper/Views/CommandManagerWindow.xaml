<Window x:Class="FactoryHelper.Views.CommandManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="命令库管理" Height="640" Width="900"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei"
        ShowInTaskbar="False">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="命令库管理 — 统一管理单条命令与命令组"
                   FontSize="13" Foreground="#555" Margin="0,0,0,8"/>

        <TabControl Grid.Row="1">
            <!-- ==================== 单条命令 ==================== -->
            <TabItem Header="单条命令">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：命令列表 -->
                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="新增" Width="64" Height="28" Margin="0,0,8,0" Click="OnNewCommandClick"/>
                            <Button Content="删除" Width="64" Height="28" Click="OnDeleteCommandClick"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="命令列表" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ListBox Name="CmdListBox" ItemsSource="{Binding Commands}"
                                 SelectedItem="{Binding SelectedCommand}"
                                 DisplayMemberPath="Name"
                                 BorderBrush="#ccc" BorderThickness="1"/>
                    </DockPanel>

                    <!-- 右侧：命令详情 -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="名称:" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Margin="0,2" Padding="4,2"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="分类:" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Category}" Margin="0,2" Padding="4,2"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="命令:" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Command}" Margin="0,2" Padding="4,2"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="超时(ms):" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TimeoutMs}" Margin="0,2" Padding="4,2"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="输入提示:" VerticalAlignment="Top" Margin="0,2"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding InputPromptsText}"
                                 Margin="0,2" Padding="4,2" TextWrapping="Wrap" Height="52"
                                 ToolTip="多个提示用逗号分隔，如: 请输入PCBID, 请输入SN"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="描述:" VerticalAlignment="Top" Margin="0,2"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Description}"
                                 Margin="0,2" Padding="4,2" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ==================== 命令组 ==================== -->
            <TabItem Header="命令组">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：命令组列表 -->
                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="新增" Width="64" Height="28" Margin="0,0,8,0" Click="OnNewGroupClick"/>
                            <Button Content="删除" Width="64" Height="28" Click="OnDeleteGroupClick"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="命令组列表" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ListBox Name="GroupListBox" DisplayMemberPath="Name"
                                 SelectionChanged="OnGroupSelectionChanged"
                                 BorderBrush="#ccc" BorderThickness="1"/>
                    </DockPanel>

                    <!-- 右侧：命令组详情 -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="组名称:" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Name="GroupNameBox" Grid.Row="0" Grid.Column="1" Margin="0,2" Padding="4,2"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="描述:" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Name="GroupDescBox" Grid.Row="1" Grid.Column="1" Margin="0,2" Padding="4,2"/>

                        <!-- 步骤表格 -->
                        <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="步骤列表" FontWeight="Bold" Margin="0,0,0,4"/>
                            <DataGrid Name="StepsGrid" AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="All"
                                      BorderBrush="#ccc" BorderThickness="1"
                                      RowHeight="28" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="30" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="120"/>
                                    <DataGridTextColumn Header="命令" Binding="{Binding Command}" Width="*"/>
                                    <DataGridTextColumn Header="延时(ms)" Binding="{Binding DelayAfterMs}" Width="80"/>
                                    <DataGridTextColumn Header="超时(ms)" Binding="{Binding TimeoutMs}" Width="80"/>
                                    <DataGridCheckBoxColumn Header="失败中断" Binding="{Binding StopOnFail}" Width="60"/>
                                    <DataGridTextColumn Header="输入提示" Binding="{Binding InputPromptsText}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <!-- 步骤操作按钮 -->
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Content="新增步骤" Width="70" Height="28" Margin="0,0,8,0" Click="OnAddStepClick"/>
                            <Button Content="删除步骤" Width="70" Height="28" Margin="0,0,8,0" Click="OnDeleteStepClick"/>
                            <Button Content="上移" Width="56" Height="28" Margin="0,0,8,0" Click="OnMoveUpClick"/>
                            <Button Content="下移" Width="56" Height="28" Click="OnMoveDownClick"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 底部保存按钮 -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Left" Text="提示: 输入提示用逗号分隔，命令中用 {0} {1} 占位"
                       FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存命令" Width="90" Height="30" Margin="0,0,8,0"
                        Background="#0078d4" Foreground="White" BorderThickness="0"
                        Click="OnSaveCommandsClick"/>
                <Button Content="保存命令组" Width="100" Height="30"
                        Background="#107c10" Foreground="White" BorderThickness="0"
                        Click="OnSaveGroupsClick"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>