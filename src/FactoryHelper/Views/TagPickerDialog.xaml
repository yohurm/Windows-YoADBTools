<Window x:Class="FactoryHelper.Views.TagPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择标签" SizeToContent="WidthAndHeight"
        Width="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei"
        ShowInTaskbar="False">

    <StackPanel Margin="14">
        <TextBlock Text="选择分组标签:" FontSize="12" Margin="0,0,0,6"/>

        <ListBox Name="TagListBox" Height="180" BorderBrush="#ccc" BorderThickness="1"
                 SelectionChanged="OnSelectionChanged"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="72" Height="30" IsDefault="True"
                    Click="OnOkClick" Margin="0,0,8,0"
                    Background="#0078d4" Foreground="White" BorderThickness="0"/>
            <Button Content="取消" Width="72" Height="30" IsCancel="True"
                    Click="OnCancelClick"/>
        </StackPanel>
    </StackPanel>
</Window>