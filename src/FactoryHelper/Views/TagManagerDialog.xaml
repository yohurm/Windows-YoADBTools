<Window x:Class="FactoryHelper.Views.TagManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="标签管理" Height="420" Width="360"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei"
        ShowInTaskbar="False">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="管理命令/命令组的分组标签"
                   FontSize="12" Foreground="#555" Margin="0,0,0,8"/>

        <ListBox Name="TagListBox" Grid.Row="1"
                 DisplayMemberPath="Name"
                 BorderBrush="#ccc" BorderThickness="1"
                 SelectionChanged="OnTagSelectionChanged"/>

        <!-- 编辑区 -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Name="TagNameBox" Grid.Column="0" Padding="4,2" Height="28"
                     TextChanged="OnTagNameChanged"
                     ToolTip="输入新标签名或修改选中的标签"/>
            <Button Grid.Column="1" Content="新增" Width="56" Height="28"
                    Margin="6,0,0,0" Click="OnAddClick"/>
            <Button Grid.Column="2" Content="重命名" Width="64" Height="28"
                    Margin="6,0,0,0" Click="OnRenameClick"/>
            <Button Grid.Column="3" Content="删除" Width="56" Height="28"
                    Margin="6,0,0,0" Click="OnDeleteClick"/>
        </Grid>
    </Grid>
</Window>