<ui:FluentWindow x:Class="FactoryHelper.Modules.AdbTerminal.Views.CommandManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="命令库管理" Height="660" Width="1100"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei"
        Closing="OnWindowClosing"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 官方标题栏：最小化/最大化/关闭 + 拖动（默认 Padding，标题不贴边） -->
        <ui:TitleBar Grid.Row="0" Title="命令库管理"
                     Icon="pack://application:,,,/app.ico"/>

        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="命令库管理 — 统一管理单条命令与命令组"
                       FontSize="13" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
        </DockPanel>

        <TabControl Grid.Row="1">
            <!-- ==================== 单条命令 ==================== -->
            <TabItem Header="单条命令">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：命令列表 -->
                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="新增" Width="64" Height="28" Margin="0,0,8,0"
                                    Command="{Binding AddCommandCommand}"/>
                            <Button Content="删除" Width="64" Height="28"
                                    Command="{Binding DeleteCommandCommand}"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="命令列表" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ListBox ItemsSource="{Binding Commands}"
                                 SelectedItem="{Binding SelectedCommand}"
                                 DisplayMemberPath="Name"
                                 BorderBrush="{StaticResource Brush.ListBorder}" BorderThickness="1"/>
                    </DockPanel>

                    <!-- 右侧：命令详情（绑定 SelectedCommand 路径，模型 INPC 即时刷新） -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="名称:" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCommand.Name}" Margin="0,2" Padding="4,2"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="分类:" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCommand.Category, TargetNullValue=''}"
                                 Margin="0,2" Padding="4,2"
                                 ToolTip="直接输入分类名称（如: 通用 / Nori产测）"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="命令:" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCommand.Command}" Margin="0,2" Padding="4,2"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="超时(ms):" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedCommand.TimeoutMs}" Margin="0,2" Padding="4,2"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="输入提示:" VerticalAlignment="Top" Margin="0,2"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedCommand.InputPromptsText}"
                                 Margin="0,2" Padding="4,2" TextWrapping="Wrap" Height="44"
                                 ToolTip="多个提示用逗号分隔，如: 请输入PCBID, 请输入SN"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="成功正则:" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedCommand.SuccessRegex}"
                                 Margin="0,2" Padding="4,2"
                                 ToolTip="输出匹配该正则即视为成功(用于 bdft 等固定返回非0的工具), 留空则仅按退出码判断"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="失败正则:" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding SelectedCommand.FailureRegex}"
                                 Margin="0,2" Padding="4,2"
                                 ToolTip="输出匹配该正则即视为失败, 优先级最高(用于参数错误返回0但输出错误信息的工具), 留空跳过"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="描述:" VerticalAlignment="Top" Margin="0,2"/>
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding SelectedCommand.Description}"
                                 Margin="0,2" Padding="4,2" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ==================== 命令组 ==================== -->
            <TabItem Header="命令组">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：命令组列表 -->
                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="新增" Width="64" Height="28" Margin="0,0,8,0"
                                    Command="{Binding AddGroupCommand}"/>
                            <Button Content="删除" Width="64" Height="28"
                                    Command="{Binding DeleteGroupCommand}"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="命令组列表" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ListBox ItemsSource="{Binding Groups}"
                                 SelectedItem="{Binding SelectedGroup}"
                                 DisplayMemberPath="Name"
                                 BorderBrush="{StaticResource Brush.ListBorder}" BorderThickness="1"/>
                    </DockPanel>

                    <!-- 右侧：组信息 + 步骤列表（两列并排：输入框组与步骤列表同列区域） -->
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左列：组信息输入框（组名称/分类/描述） -->
                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="组名称:" VerticalAlignment="Center" Margin="0,2"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedGroup.Name}" Margin="0,2" Padding="4,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="分类:" VerticalAlignment="Center" Margin="0,2"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedGroup.Category, TargetNullValue=''}"
                                     Margin="0,2" Padding="4,2"
                                     ToolTip="直接输入分类名称（如: 通用 / Nori产测）"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="描述:" VerticalAlignment="Center" Margin="0,2"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedGroup.Description}"
                                     Margin="0,2" Padding="4,2" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Grid>

                        <!-- 右列：步骤列表（与输入框组同一行区域并排） -->
                        <DockPanel Grid.Column="1">
                            <TextBlock DockPanel.Dock="Top" Text="步骤列表" FontWeight="Bold" Margin="0,0,0,4"/>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Content="新增步骤" Width="70" Height="28" Margin="0,0,8,0"
                                        Command="{Binding AddStepCommand}"/>
                                <Button Content="删除步骤" Width="70" Height="28" Margin="0,0,8,0"
                                        Command="{Binding DeleteStepCommand}"/>
                                <Button Content="上移" Width="56" Height="28" Margin="0,0,8,0"
                                        Command="{Binding MoveStepUpCommand}"/>
                                <Button Content="下移" Width="56" Height="28"
                                        Command="{Binding MoveStepDownCommand}"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding SelectedGroup.Steps}"
                                      SelectedItem="{Binding SelectedStep}"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="All"
                                      BorderBrush="{StaticResource Brush.ListBorder}" BorderThickness="1"
                                      RowHeight="28" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="步骤名" Binding="{Binding Name}" Width="80"/>
                                    <DataGridTextColumn Header="命令" Binding="{Binding Command}" Width="*" MinWidth="140"/>
                                    <DataGridTextColumn Header="延时(ms)" Binding="{Binding DelayAfterMs}" Width="55"/>
                                    <DataGridTextColumn Header="超时(ms)" Binding="{Binding TimeoutMs}" Width="55"/>
                                    <DataGridCheckBoxColumn Header="中断" Binding="{Binding StopOnFail}" Width="45"/>
                                    <DataGridTextColumn Header="输入提示" Binding="{Binding InputPromptsText}" Width="60"/>
                                    <DataGridTextColumn Header="成功正则" Binding="{Binding SuccessRegex}" Width="60"/>
                                    <DataGridTextColumn Header="失败正则" Binding="{Binding FailureRegex}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 底部：保存 -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{Binding SaveMessage}"
                       FontSize="11" VerticalAlignment="Center"
                       Foreground="{StaticResource Brush.TextTertiary}"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="保存" Width="110" Height="30"
                        Appearance="Primary" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
