<ui:FluentWindow x:Class="FactoryHelper.Modules.AdbTerminal.Views.CommandManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="命令库管理" Height="680" Width="1100"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei"
        Closing="OnWindowClosing"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <!-- ============================================================
         设计系统（本窗口统一）：
         - 字体层级: 面板标题 16 SemiBold / 分区标题 13 SemiBold
                    / 字段标签 12 Secondary / 输入内容 13 / 辅助 11 Tertiary
         - 间距节奏: 4/8/12/16 基准；字段行距 8；分区间距 16
         - 对齐: 标签列宽统一 84，输入框同高 30
         ============================================================ -->
    <Window.Resources>
        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 官方标题栏（默认 Padding，标题不贴边） -->
        <ui:TitleBar Grid.Row="0" Title="命令库管理"
                     Icon="pack://application:,,,/app.ico"/>

        <Grid Grid.Row="1" Margin="16,10,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 面板标题 + 说明 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="命令库管理" Style="{StaticResource PanelTitleStyle}"/>
                <TextBlock Text="统一管理单条命令与命令组 — 输入提示用逗号分隔，命令中用 {0} {1} 占位"
                           FontSize="11" Foreground="{StaticResource Brush.TextTertiary}"
                           Margin="0,3,0,0"/>
            </StackPanel>

            <TabControl Grid.Row="1">
                <!-- ==================== 单条命令 ==================== -->
                <TabItem Header="单条命令">
                    <Grid Margin="8,10,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左列：命令列表 -->
                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="新增" Style="{StaticResource ActionButtonStyle}"
                                        Margin="0,0,8,0" Command="{Binding AddCommandCommand}"/>
                                <Button Content="删除" Style="{StaticResource ActionButtonStyle}"
                                        Command="{Binding DeleteCommandCommand}"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Text="命令列表" Style="{StaticResource SectionTitleStyle}"/>
                            <ListBox ItemsSource="{Binding Commands}"
                                     SelectedItem="{Binding SelectedCommand}"
                                     DisplayMemberPath="Name"
                                     BorderBrush="{StaticResource Brush.ListBorder}" BorderThickness="1"/>
                        </DockPanel>

                        <!-- 右列：命令详情 -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" Style="{StaticResource FieldLabelStyle}" Margin="0,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource InputBoxStyle}" Margin="0,4"
                                     Text="{Binding SelectedCommand.Name}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="分类" Style="{StaticResource FieldLabelStyle}" Margin="0,4"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource InputBoxStyle}" Margin="0,4"
                                     Text="{Binding SelectedCommand.Category, TargetNullValue=''}"
                                     ToolTip="直接输入分类名称（如: 通用 / Nori产测）"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="命令" Style="{StaticResource FieldLabelStyle}" Margin="0,4"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource InputBoxStyle}" Margin="0,4"
                                     Text="{Binding SelectedCommand.Command}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="超时(ms)" Style="{StaticResource FieldLabelStyle}" Margin="0,4"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource InputBoxStyle}" Margin="0,4"
                                     Text="{Binding SelectedCommand.TimeoutMs}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="输入提示" Style="{StaticResource FieldLabelStyle}" Margin="0,4"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,4" Padding="6,3"
                                     Text="{Binding SelectedCommand.InputPromptsText}"
                                     TextWrapping="Wrap" Height="52" FontSize="13"
                                     ToolTip="多个提示用逗号分隔，如: 请输入PCBID, 请输入SN"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="成功正则" Style="{StaticResource FieldLabelStyle}" Margin="0,4"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource InputBoxStyle}" Margin="0,4"
                                     Text="{Binding SelectedCommand.SuccessRegex}"
                                     ToolTip="输出匹配该正则即视为成功(用于 bdft 等固定返回非0的工具), 留空则仅按退出码判断"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="失败正则" Style="{StaticResource FieldLabelStyle}" Margin="0,4"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource InputBoxStyle}" Margin="0,4"
                                     Text="{Binding SelectedCommand.FailureRegex}"
                                     ToolTip="输出匹配该正则即视为失败, 优先级最高(用于参数错误返回0但输出错误信息的工具), 留空跳过"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="描述" Style="{StaticResource FieldLabelStyle}" Margin="0,4"/>
                            <TextBox Grid.Row="7" Grid.Column="1" Margin="0,4" Padding="6,3"
                                     Text="{Binding SelectedCommand.Description}"
                                     TextWrapping="Wrap" FontSize="13"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ==================== 命令组 ==================== -->
                <TabItem Header="命令组">
                    <Grid Margin="8,10,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左列：命令组列表 -->
                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="新增" Style="{StaticResource ActionButtonStyle}"
                                        Margin="0,0,8,0" Command="{Binding AddGroupCommand}"/>
                                <Button Content="删除" Style="{StaticResource ActionButtonStyle}"
                                        Command="{Binding DeleteGroupCommand}"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Text="命令组列表" Style="{StaticResource SectionTitleStyle}"/>
                            <ListBox ItemsSource="{Binding Groups}"
                                     SelectedItem="{Binding SelectedGroup}"
                                     DisplayMemberPath="Name"
                                     BorderBrush="{StaticResource Brush.ListBorder}" BorderThickness="1"/>
                        </DockPanel>

                        <!-- 右列：组信息 + 步骤列表（同列上下：步骤列表与分类/描述同一列） -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 分区 1：基本信息 -->
                            <TextBlock Grid.Row="0" Text="基本信息" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6"/>
                            <Grid Grid.Row="1" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="组名称" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource InputBoxStyle}"
                                         Text="{Binding SelectedGroup.Name}"/>
                            </Grid>
                            <Grid Grid.Row="2" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="分类" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource InputBoxStyle}"
                                         Text="{Binding SelectedGroup.Category, TargetNullValue=''}"
                                         ToolTip="直接输入分类名称（如: 通用 / Nori产测）"/>
                            </Grid>
                            <Grid Grid.Row="3" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="描述" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource InputBoxStyle}"
                                         Text="{Binding SelectedGroup.Description}"/>
                            </Grid>

                            <!-- 分区 2：步骤列表（与基本信息/分类/描述同一列，x 对齐） -->
                            <TextBlock Grid.Row="4" Text="步骤列表" Style="{StaticResource SectionTitleStyle}"
                                       Margin="84,14,0,8"/>
                            <DataGrid Grid.Row="5" Margin="84,0,0,0"
                                      ItemsSource="{Binding SelectedGroup.Steps}"
                                      SelectedItem="{Binding SelectedStep}"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="All"
                                      BorderBrush="{StaticResource Brush.ListBorder}" BorderThickness="1"
                                      RowHeight="30" CanUserAddRows="False"
                                      FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="步骤名" Binding="{Binding Name}" Width="100"/>
                                    <DataGridTextColumn Header="命令" Binding="{Binding Command}" Width="*" MinWidth="180"/>
                                    <DataGridTextColumn Header="延时(ms)" Binding="{Binding DelayAfterMs}" Width="55"/>
                                    <DataGridTextColumn Header="超时(ms)" Binding="{Binding TimeoutMs}" Width="55"/>
                                    <DataGridCheckBoxColumn Header="中断" Binding="{Binding StopOnFail}" Width="48"/>
                                    <DataGridTextColumn Header="输入提示" Binding="{Binding InputPromptsText}" Width="70"/>
                                    <DataGridTextColumn Header="成功正则" Binding="{Binding SuccessRegex}" Width="70"/>
                                    <DataGridTextColumn Header="失败正则" Binding="{Binding FailureRegex}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 步骤操作按钮 -->
                            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="新增步骤" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"
                                        Command="{Binding AddStepCommand}"/>
                                <Button Content="删除步骤" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"
                                        Command="{Binding DeleteStepCommand}"/>
                                <Button Content="上移" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"
                                        Command="{Binding MoveStepUpCommand}"/>
                                <Button Content="下移" Style="{StaticResource ActionButtonStyle}"
                                        Command="{Binding MoveStepDownCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- 底部：保存 -->
            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock DockPanel.Dock="Left" Text="{Binding SaveMessage}"
                           FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextSecondary}"/>
                <ui:Button DockPanel.Dock="Right" Content="保存" Width="110" Height="32"
                           Appearance="Primary" Command="{Binding SaveCommand}"/>
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
