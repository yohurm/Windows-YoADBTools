<Window x:Class="FactoryHelper.Modules.AdbTerminal.Views.TagPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择分类" Height="300" Width="240"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="TagListBox" Grid.Row="0"
                 SelectionChanged="OnSelectionChanged"
                 BorderThickness="1" BorderBrush="#ccc"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="确定" Width="70" Height="28" Margin="0,0,8,0" Click="OnOkClick"/>
            <Button Content="取消" Width="70" Height="28" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
