<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         UI Token 统一管理 — 颜色 / 间距 / 圆角 / 字体
         修改此处即可全局生效，禁止在 XAML 中散落硬编码值
         ============================================================ -->

    <!-- ===== 颜色 Tokens ===== -->
    <Color x:Key="Color.NavBg">#E9EDF1</Color>
    <Color x:Key="Color.ContentBg">#FBFCFD</Color>
    <Color x:Key="Color.PanelBg">#FFFFFF</Color>
    <Color x:Key="Color.PanelBorder">#C9D2DA</Color>
    <Color x:Key="Color.ListBg">#F7F9FA</Color>
    <Color x:Key="Color.ListBorder">#D5DBE1</Color>
    <Color x:Key="Color.TextPrimary">#1A1A1A</Color>
    <Color x:Key="Color.TextSecondary">#5A5A5A</Color>
    <Color x:Key="Color.TextTertiary">#8A8A8A</Color>
    <Color x:Key="Color.Accent">#0F3C74</Color>
    <Color x:Key="Color.AccentBg">#D6E4F7</Color>
    <Color x:Key="Color.Warning">#C8511C</Color>
    <Color x:Key="Color.Tag">#8A5A00</Color>
    <Color x:Key="Color.Splitter">#B9C2CC</Color>
    <Color x:Key="Color.SplitterHover">#6E7680</Color>

    <!-- ===== Brush Tokens ===== -->
    <SolidColorBrush x:Key="Brush.NavBg" Color="{StaticResource Color.NavBg}"/>
    <SolidColorBrush x:Key="Brush.ContentBg" Color="{StaticResource Color.ContentBg}"/>
    <SolidColorBrush x:Key="Brush.PanelBg" Color="{StaticResource Color.PanelBg}"/>
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="{StaticResource Color.PanelBorder}"/>
    <SolidColorBrush x:Key="Brush.ListBg" Color="{StaticResource Color.ListBg}"/>
    <SolidColorBrush x:Key="Brush.ListBorder" Color="{StaticResource Color.ListBorder}"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentBg" Color="{StaticResource Color.AccentBg}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.Tag" Color="{StaticResource Color.Tag}"/>
    <SolidColorBrush x:Key="Brush.Splitter" Color="{StaticResource Color.Splitter}"/>
    <SolidColorBrush x:Key="Brush.SplitterHover" Color="{StaticResource Color.SplitterHover}"/>

    <!-- ===== 间距 Tokens（4px 基准，Fluent 规范） ===== -->
    <Thickness x:Key="Space.None">0</Thickness>
    <Thickness x:Key="Space.Xs">4</Thickness>
    <Thickness x:Key="Space.Sm">8</Thickness>
    <Thickness x:Key="Space.Md">12</Thickness>
    <Thickness x:Key="Space.Lg">16</Thickness>
    <Thickness x:Key="Space.Xl">24</Thickness>

    <!-- ===== 面板 Padding Tokens ===== -->
    <Thickness x:Key="Padding.Panel">14,12</Thickness>
    <Thickness x:Key="Padding.Page">14,10,14,14</Thickness>

    <!-- ===== 圆角 Tokens ===== -->
    <CornerRadius x:Key="Radius.Sm">4</CornerRadius>
    <CornerRadius x:Key="Radius.Md">6</CornerRadius>

    <!-- ===== 边框 Tokens ===== -->
    <Thickness x:Key="Border.Panel">1</Thickness>
    <Thickness x:Key="Border.Splitter">0</Thickness>

    <!-- ===== 尺寸 Tokens（面板宽度体系） ===== -->
    <sys:Double x:Key="Size.LeftPanel" xmlns:sys="clr-namespace:System;assembly=System.Runtime">290</sys:Double>
    <sys:Double x:Key="Size.LeftPanelMin" xmlns:sys="clr-namespace:System;assembly=System.Runtime">240</sys:Double>
    <sys:Double x:Key="Size.InputPanel" xmlns:sys="clr-namespace:System;assembly=System.Runtime">280</sys:Double>
    <sys:Double x:Key="Size.InputPanelMin" xmlns:sys="clr-namespace:System;assembly=System.Runtime">220</sys:Double>
    <sys:Double x:Key="Size.InputPanelMax" xmlns:sys="clr-namespace:System;assembly=System.Runtime">440</sys:Double>
    <sys:Double x:Key="Size.LogPanelMin" xmlns:sys="clr-namespace:System;assembly=System.Runtime">340</sys:Double>

    <!-- ===== 列间距体系（分界线两侧等距 12px） ===== -->
    <Thickness x:Key="Margin.ColumnLeft">0,0,12,0</Thickness>
    <Thickness x:Key="Margin.ColumnMid">12,0,12,0</Thickness>
    <Thickness x:Key="Margin.ColumnRight">12,0,0,0</Thickness>
    <Thickness x:Key="Margin.PanelGap">0,0,0,10</Thickness>
    <Thickness x:Key="Margin.Toolbar">0,0,0,12</Thickness>

    <!-- ===== 字体 Tokens ===== -->
    <FontFamily x:Key="Font.Family">Microsoft YaHei</FontFamily>
    <sys:Double x:Key="Font.Size.Sm" xmlns:sys="clr-namespace:System;assembly=System.Runtime">11</sys:Double>
    <sys:Double x:Key="Font.Size.Md" xmlns:sys="clr-namespace:System;assembly=System.Runtime">13</sys:Double>
    <sys:Double x:Key="Font.Size.Lg" xmlns:sys="clr-namespace:System;assembly=System.Runtime">17</sys:Double>

    <!-- ===== 复合样式 ===== -->
    <Style x:Key="PanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.PanelBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Border.Panel}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
        <Setter Property="Padding" Value="{StaticResource Padding.Panel}"/>
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- 分界线：细线（2px），悬停轻微高亮 -->
    <Style x:Key="SplitterStyle" TargetType="GridSplitter">
        <Setter Property="Width" Value="2"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
        <Setter Property="Background" Value="{StaticResource Brush.Splitter}"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.SplitterHover}"/>
                <Setter Property="Width" Value="3"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>