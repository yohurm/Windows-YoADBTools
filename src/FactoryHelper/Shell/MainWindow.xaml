<ui:FluentWindow x:Class="FactoryHelper.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        FontFamily="{StaticResource Font.Family}"
        xmlns:beh="clr-namespace:FactoryHelper.Core"
        Title="Yovo ADB Tools"
        Width="1200" Height="740"
        MinHeight="560" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource Size.ShellNav}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======== 官方 TitleBar ======== -->
        <ui:TitleBar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                     Title="Yovo ADB Tools"
                     Icon="pack://application:,,,/app.ico"/>

        <!-- ======== 左侧：设备（可折叠）+ 模块导航 ======== -->
        <Border Grid.Row="1" Grid.Column="0"
                ClipToBounds="True"
                Background="{StaticResource Brush.NavBg}"
                BorderBrush="{StaticResource Brush.PanelBorder}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="0,8,0,0">

                <!-- 设备面板（标题行可折叠） -->
                <StackPanel DockPanel.Dock="Top" Margin="12,0,12,12"
                            DataContext="{Binding DevicePanel}">
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="设备" FontSize="{StaticResource Font.Size.Body}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <ui:Button DockPanel.Dock="Right" Content="刷新" FontSize="{StaticResource Font.Size.Caption}"
                                   Appearance="Secondary" Command="{Binding RefreshCommand}"
                                   Cursor="Hand"/>
                        <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsDevicesExpanded}"
                                      Content="▾" Width="20" Height="20"
                                      Margin="0,0,4,0" Cursor="Hand"
                                      ToolTip="折叠/展开设备列表"
                                      Background="Transparent" BorderThickness="0"/>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Devices}"
                             SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             BorderBrush="{StaticResource Brush.ListBorder}" BorderThickness="1"
                             Background="{StaticResource Brush.ListBg}"
                             beh:SelectedItemsBehavior.SelectedItems="{Binding SelectedDevices}"
                             Visibility="{Binding IsDevicesExpanded, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource DeviceListItemStyle}"/>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                             DockPanel.Dock="Left"
                                             VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Brush.Offline}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Brush.Success}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Model}" FontSize="{StaticResource Font.Size.Body}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Serial}" FontSize="{StaticResource Font.Size.Caption}"
                                                   Foreground="{StaticResource Brush.TextTertiary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- 模块导航 -->
                <StackPanel DockPanel.Dock="Top" Margin="20,0,16,4">
                    <TextBlock Text="模块" FontSize="{StaticResource Font.Size.Body}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Modules}"
                         SelectedItem="{Binding SelectedModule}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavListItemStyle}"/>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding IconGlyph}" FontSize="16"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"/>
                                <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ======== 右侧：统一操作面板 ======== -->
        <Grid Grid.Row="1" Grid.Column="1"
              Background="{StaticResource Brush.ContentBg}">
            <ContentControl Content="{Binding CurrentView}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </Grid>

        <!-- ======== 底部状态栏 ======== -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Padding="14,5" BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource Brush.PanelBorder}"
                Background="{StaticResource Brush.NavBg}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Yovo ADB Tools v1.0"
                           FontSize="{StaticResource Font.Size.Caption}"
                           Foreground="{StaticResource Brush.TextTertiary}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="设备: " FontSize="{StaticResource Font.Size.Caption}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextSecondary}"/>
                    <TextBlock Text="{Binding DevicePanel.StatusText}"
                               FontSize="{StaticResource Font.Size.Caption}"
                               FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Success}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DevicePanel.IsRefreshing}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Warn}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
