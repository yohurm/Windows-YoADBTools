<UserControl x:Class="FactoryHelper.Shell.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="{StaticResource Font.Family}">

    <!-- 设置面板 — 右侧统一操作面板中的平台面板（信息架构：标题 → 说明 → 卡片 → 反馈 → 操作） -->
    <Grid Margin="{StaticResource Padding.Page}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">

                <!-- 页面标题 + 说明 -->
                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="平台级配置 — ADB 路径与数据目录"
                           FontSize="{StaticResource Font.Size.Body}"
                           Foreground="{StaticResource Brush.TextTertiary}" Margin="0,4,0,0"/>

                <!-- 设置卡片：ADB 路径 -->
                <Border Style="{StaticResource PanelBorderStyle}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="{StaticResource Size.FormInputCol}"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="ADB 路径" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,3"/>
                            <TextBlock Text="留空自动解析：应用目录 Tools → 内置 ADB 解压。保存后立即生效。"
                                       FontSize="{StaticResource Font.Size.Caption}"
                                       Foreground="{StaticResource Brush.TextTertiary}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:Button DockPanel.Dock="Right" Content="浏览…" Appearance="Secondary"
                                       Margin="8,0,0,0" Command="{Binding BrowseAdbPathCommand}"/>
                            <ui:TextBox Text="{Binding AdbPath}"
                                        ToolTip="adb.exe 或所在目录；留空自动解析"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- 设置卡片：数据目录 -->
                <Border Style="{StaticResource PanelBorderStyle}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="{StaticResource Size.FormInputCol}"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="数据目录" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,3"/>
                            <TextBlock Text="命令库 / ADB 等文件的存放位置。留空为默认。保存后重启应用生效。"
                                       FontSize="{StaticResource Font.Size.Caption}"
                                       Foreground="{StaticResource Brush.TextTertiary}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:Button DockPanel.Dock="Right" Content="浏览…" Appearance="Secondary"
                                       Margin="8,0,0,0" Command="{Binding BrowseDataDirCommand}"/>
                            <ui:TextBox Text="{Binding DataDir}"
                                        ToolTip="默认 %LOCALAPPDATA%\YovoAdbTools；留空恢复默认"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- 反馈消息 -->
                <TextBlock Text="{Binding Message}"
                           FontSize="{StaticResource Font.Size.Body}"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           TextWrapping="Wrap" Margin="0,12,0,0"/>

                <!-- 操作区 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <ui:Button Content="恢复默认" Appearance="Secondary"
                               Margin="0,0,10,0" Command="{Binding RestoreDefaultsCommand}"/>
                    <ui:Button Content="保存" Appearance="Primary" Width="96"
                               Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
