<UserControl x:Class="FactoryHelper.Shell.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="Microsoft YaHei">

    <!-- 设置面板 — 右侧统一操作面板中的平台面板（导航-内容框架） -->
    <Grid Margin="{StaticResource Padding.Page}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">

                <!-- 面板标题 -->
                <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextPrimary}"/>
                <TextBlock Text="平台级配置 — ADB 路径与数据目录" FontSize="12"
                           Foreground="{StaticResource Brush.TextTertiary}" Margin="0,4,0,0"/>

                <!-- 设置卡片：ADB 路径 -->
                <Border Style="{StaticResource PanelBorderStyle}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="ADB 路径" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}"/>
                            <TextBlock Text="留空自动解析：应用目录 Tools → 内置 ADB 解压。保存后立即生效。"
                                       FontSize="11" Foreground="{StaticResource Brush.TextTertiary}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button DockPanel.Dock="Right" Content="浏览…" Width="64" Height="30"
                                    Margin="8,0,0,0" Command="{Binding BrowseAdbPathCommand}"/>
                            <TextBox Text="{Binding AdbPath}" Height="30" Padding="6,4"
                                     VerticalContentAlignment="Center"
                                     ToolTip="adb.exe 或所在目录；留空自动解析"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- 设置卡片：数据目录 -->
                <Border Style="{StaticResource PanelBorderStyle}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="数据目录" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}"/>
                            <TextBlock Text="命令库 / ADB 等文件的存放位置。留空为默认。保存后重启应用生效。"
                                       FontSize="11" Foreground="{StaticResource Brush.TextTertiary}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button DockPanel.Dock="Right" Content="浏览…" Width="64" Height="30"
                                    Margin="8,0,0,0" Command="{Binding BrowseDataDirCommand}"/>
                            <TextBox Text="{Binding DataDir}" Height="30" Padding="6,4"
                                     VerticalContentAlignment="Center"
                                     ToolTip="默认 %LOCALAPPDATA%\YovoAdbTools；留空恢复默认"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- 反馈消息 -->
                <TextBlock Text="{Binding Message}" FontSize="12"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           TextWrapping="Wrap" Margin="0,12,0,0"/>

                <!-- 操作区 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="恢复默认" Width="84" Height="32" Margin="0,0,10,0"
                            Command="{Binding RestoreDefaultsCommand}"/>
                    <ui:Button Content="保存" Width="96" Height="32" Appearance="Primary"
                               Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
