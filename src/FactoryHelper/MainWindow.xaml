<ui:FluentWindow x:Class="FactoryHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Yovo ADB Tools" Height="700" Width="1150"
        MinHeight="550" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======== 左侧：平台侧边导航 ======== -->
        <Border Grid.Row="0" Grid.Column="0" Width="210"
                Background="{DynamicResource ControlFillColorSecondary}"
                BorderBrush="{DynamicResource DividerStrokeColorDefault}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="0,44,0,0">
                <!-- 平台标题 -->
                <StackPanel DockPanel.Dock="Top" Margin="16,0,16,16">
                    <TextBlock Text="Yovo ADB Tools" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimary}"/>
                    <TextBlock Text="多模块工具平台" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiary}"/>
                </StackPanel>

                <!-- 模块导航（动态生成） -->
                <ListBox x:Name="ModuleNavList"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnModuleSelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="8,2"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimary}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorInputActive}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondary}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ======== 右侧：模块内容区 ======== -->
        <Grid Grid.Row="0" Grid.Column="1">
            <ContentControl x:Name="ModuleHost"/>
        </Grid>

        <!-- ======== 底部状态栏 ======== -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Padding="12,4" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderStrokeColorDefault}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Yovo ADB Tools v1.0"
                           FontSize="11" Foreground="{DynamicResource TextFillColorSecondary}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="ADB: " FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondary}"/>
                    <TextBlock Name="TxtAdbStatus" Text="{Binding AdbStatus}" FontSize="11"
                               FontWeight="SemiBold" Foreground="#4caf50" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>