<Window x:Class="FactoryHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FactoryHelper"
        xmlns:vm="clr-namespace:FactoryHelper.ViewModels"
        mc:Ignorable="d"
        Title="产测助手 — GGEC-nori" Height="650" Width="1050"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======== 顶部工具栏 ======== -->
        <Border Grid.Row="0" Background="#f0f0f0" Padding="10,8" BorderBrush="#d0d0d0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="刷新设备" Command="{Binding RefreshDevicesCommand}"
                            Width="80" Margin="0,0,10,0" Height="28"/>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                               Foreground="#555" FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="ADB 状态: " VerticalAlignment="Center" FontSize="12"/>
                    <TextBlock Name="TxtAdbStatus" Text="检查中..." VerticalAlignment="Center"
                               FontSize="12" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======== 主内容区 ======== -->
        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧面板：设备列表 + 命令/命令组 ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 设备列表 -->
                <Border Grid.Row="0" BorderBrush="#d0d0d0" BorderThickness="0,0,0,1" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="设备列表" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                        <ListBox Name="DeviceListBox" ItemsSource="{Binding Devices}"
                                 SelectionMode="Extended" Height="120"
                                 DisplayMemberPath="DisplayName"
                                 BorderBrush="#ccc" BorderThickness="1"/>
                        <TextBlock Text="提示: 按住 Ctrl 多选设备" FontSize="11"
                                   Foreground="#888" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 命令/命令组标签页 -->
                <TabControl Grid.Row="1" Margin="0,0,0,0" Padding="0">
                    <TabItem Header="单条命令">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 分类筛选 -->
                            <ComboBox Grid.Row="0" ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      Margin="8,6,8,4" Height="26"/>

                            <!-- 命令列表 -->
                            <ListBox Grid.Row="1" ItemsSource="{Binding Commands}"
                                     SelectedItem="{Binding SelectedCommand}"
                                     Margin="8,0,8,8"
                                     BorderBrush="#ccc" BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2" Orientation="Horizontal">
                                            <!-- 需要输入的命令显示输入标记 -->
                                            <TextBlock Text="[输入]" FontSize="10" FontWeight="Bold"
                                                       Foreground="#c8511c" VerticalAlignment="Center"
                                                       Visibility="{Binding RequiresInput, Converter={StaticResource BoolToVisibility}}"
                                                       Margin="0,0,4,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Command}" FontSize="11"
                                                           Foreground="#666" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="命令组">
                        <ListBox ItemsSource="{Binding CommandGroups}"
                                 SelectedItem="{Binding SelectedGroup}"
                                 Margin="8,8,8,8"
                                 BorderBrush="#ccc" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="#666" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- ===== 右侧面板：日志 + 执行按钮 ===== -->
            <Grid Grid.Column="1" Margin="10,8,10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 执行按钮 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="执行命令" Command="{Binding ExecuteCommandCommand}"
                            Width="90" Height="32" Margin="0,0,10,0"
                            Background="#0078d4" Foreground="White"
                            FontWeight="Bold" BorderThickness="0"/>
                    <Button Content="执行命令组" Command="{Binding ExecuteGroupCommand}"
                            Width="100" Height="32" Margin="0,0,10,0"
                            Background="#107c10" Foreground="White"
                            FontWeight="Bold" BorderThickness="0"/>
                    <Button Content="清空日志" Command="{Binding ClearLogCommand}"
                            Width="80" Height="32"/>
                </StackPanel>

                <!-- 日志输出 -->
                <Border Grid.Row="1" BorderBrush="#ccc" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <TextBox Name="LogTextBox" Text="{Binding LogOutput, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 BorderThickness="0" Padding="8,6"
                                 FontFamily="Consolas" FontSize="12"
                                 Background="White" VerticalScrollBarVisibility="Auto"/>
                    </ScrollViewer>
                </Border>

                <!-- 底部状态 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                    <ProgressBar Name="BusyProgressBar" Width="100" Height="6"
                                 IsIndeterminate="{Binding IsBusy}"
                                 Visibility="Collapsed"
                                 Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#555"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ======== 底部状态栏 ======== -->
        <Border Grid.Row="2" Background="#f0f0f0" Padding="10,4" BorderBrush="#d0d0d0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="GGEC-nori 产测助手 v1.0" FontSize="11" Foreground="#888"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>