<ui:FluentWindow x:Class="FactoryHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Yovo ADB Tools"
        Width="1200" Height="740"
        MinHeight="560" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        FontFamily="Microsoft YaHei">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ======== 官方 TitleBar（最小化/最大化/关闭 + 拖动） ======== -->
        <ui:TitleBar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                     Title="Yovo ADB Tools"
                     Icon="pack://application:,,,/app.ico"
                     Padding="0"/>

        <!-- ======== 左侧：平台公共区（固定 220px） ======== -->
        <Border Grid.Row="1" Grid.Column="0"
                Width="220"
                ClipToBounds="True"
                Background="{StaticResource Brush.NavBg}"
                BorderBrush="{StaticResource Brush.PanelBorder}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="0,8,0,0" MaxWidth="220">
                <!-- 平台标题 -->
                <StackPanel DockPanel.Dock="Top" Margin="20,0,16,12">
                    <TextBlock Text="Yovo ADB Tools" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}"
                               MaxWidth="184" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="多模块工具平台" FontSize="11" Margin="0,2,0,0"
                               Foreground="{StaticResource Brush.TextTertiary}"
                               MaxWidth="184" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- 设备面板 -->
                <StackPanel DockPanel.Dock="Top" Margin="12,0,12,12">
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="设备" FontWeight="SemiBold" FontSize="12.5"
                                   Foreground="{StaticResource Brush.TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="刷新" FontSize="11"
                                Command="{Binding RefreshDevicesCommand}"
                                Padding="8,2" Background="Transparent"
                                BorderBrush="{StaticResource Brush.PanelBorder}"
                                Foreground="{StaticResource Brush.TextSecondary}"
                                Cursor="Hand"/>
                    </DockPanel>
                    <ListBox x:Name="DeviceListBox" ItemsSource="{Binding Devices}"
                             SelectionMode="Extended" MaxHeight="160"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             BorderBrush="{StaticResource Brush.ListBorder}" BorderThickness="1"
                             Background="{StaticResource Brush.ListBg}"
                             SelectionChanged="OnDeviceSelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 设备行：DockPanel 布局，状态点固定左列垂直居中 -->
                                <DockPanel>
                                    <!-- 状态点：左对齐垂直居中 -->
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                             DockPanel.Dock="Left"
                                             VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#9E9E9E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill" Value="#2E7D32"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <!-- 右侧：上下两行（名称 + 序列号） -->
                                    <StackPanel>
                                        <TextBlock Text="{Binding Model}" FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SerialNumber}" FontSize="10.5"
                                                   Foreground="{StaticResource Brush.TextTertiary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- 模块导航 -->
                <StackPanel DockPanel.Dock="Top" Margin="20,0,16,4">
                    <TextBlock Text="模块" FontWeight="SemiBold" FontSize="12.5"
                               Foreground="{StaticResource Brush.TextPrimary}"/>
                </StackPanel>
                <ListBox x:Name="ModuleNavList"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnModuleSelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="10,2"/>
                            <Setter Property="Padding" Value="12,9"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FontSize" Value="13.5"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.AccentBg}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E8EEF6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding IconChar}" FontSize="16"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"/>
                                <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ======== 右侧：模块内容区 ======== -->
        <Grid Grid.Row="1" Grid.Column="1"
              Background="{StaticResource Brush.ContentBg}">
            <ContentControl x:Name="ModuleHost"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </Grid>

        <!-- ======== 底部状态栏 ======== -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Padding="14,5" BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource Brush.PanelBorder}"
                Background="{StaticResource Brush.NavBg}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Yovo ADB Tools v1.0"
                           FontSize="11" Foreground="{StaticResource Brush.TextTertiary}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="ADB: " FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextSecondary}"/>
                    <TextBlock Name="TxtAdbStatus" Text="{Binding AdbStatus}" FontSize="11"
                               FontWeight="SemiBold" Foreground="#2e7d32" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>