<UserControl x:Class="Yovo.Modules.FileManager.Presentation.Views.FileManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="{StaticResource Font.Family}">

    <Grid Margin="{StaticResource Padding.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏：文件操作（危险删除 / 上传下载入口） -->
        <DockPanel Grid.Row="0" Margin="{StaticResource Margin.Toolbar}">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <ui:Button Content="刷新" Command="{Binding RefreshCommand}"
                           Appearance="Secondary" Margin="0,0,10,0" Icon="FluentRefresh24"/>
                <ui:Button Content="上一级" Command="{Binding NavigateUpCommand}"
                           Appearance="Secondary" Margin="0,0,10,0" Icon="FluentArrowUp24"/>
                <ui:Button Content="新建目录" Command="{Binding CreateDirectoryCommand}"
                           Appearance="Secondary" Margin="0,0,10,0" Icon="FluentFolderAdd24"/>
                <ui:Button Content="上传" Command="{Binding UploadCommand}"
                           Appearance="Primary" Margin="0,0,10,0" Icon="FluentArrowUpload24"/>
                <ui:Button Content="下载" Command="{Binding DownloadCommand}"
                           Appearance="Primary" Margin="0,0,10,0" Icon="FluentArrowDownload24"/>
                <ui:Button Content="删除" Command="{Binding DeleteCommand}"
                           Appearance="Secondary" Icon="FluentDelete24"/>
            </StackPanel>
        </DockPanel>

        <!-- 当前路径 -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Padding="10,6" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="路径:" FontSize="{StaticResource Font.Size.Caption}"
                           Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentPathText}" FontSize="{StaticResource Font.Size.Body}"
                           FontFamily="{StaticResource Font.Family.Mono}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- 文件列表（双击目录进入 / 双击文件下载） -->
        <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}" Padding="0">
            <ListView x:Name="FileList"
                      ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding SelectedEntry}"
                      MouseDoubleClick="OnFileListDoubleClick"
                      BorderThickness="0"
                      FontSize="{StaticResource Font.Size.Body}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource ListItemStyle}"/>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="名称" Width="280">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource Brush.Tag}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="大小" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Size, StringFormat={}{0:N0} B}"
                                               FontSize="{StaticResource Font.Size.Caption}"
                                               Foreground="{StaticResource Brush.TextSecondary}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsDirectory, Converter={StaticResource InverseBoolToVisibility}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="类型" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="{StaticResource Font.Size.Caption}"
                                               Foreground="{StaticResource Brush.TextSecondary}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="文件"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                        <Setter Property="Text" Value="目录"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="路径" Width="*">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Path}" FontSize="{StaticResource Font.Size.Caption}"
                                               Foreground="{StaticResource Brush.TextTertiary}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- 底部状态 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <ProgressBar Width="140" Height="6"
                         Value="{Binding TransferPercent}" Maximum="100"
                         Visibility="{Binding TransferPercent, Converter={StaticResource NullToCollapsed}}"
                         Margin="0,0,10,0"/>
            <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource Font.Size.Body}"
                       Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
