<UserControl x:Class="Yovo.Modules.LogAnalyzer.Presentation.Views.LogAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Yovo.Modules.LogAnalyzer.Presentation.Views"
             FontFamily="{StaticResource Font.Family}">

    <UserControl.Resources>
        <!-- 会话 Tab 头：信号红点 + 标题 + 关闭按钮 -->
        <DataTemplate x:Key="SessionTabHeader">
            <DockPanel Margin="0,2">
                <Ellipse x:Name="SignalDot" DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,6,0"
                         VerticalAlignment="Center" Fill="{StaticResource Brush.Error}"
                         Visibility="{Binding SignalCount, Converter={StaticResource IntToVisibility}}"
                         ToolTip="本会话检测到崩溃/异常信号"/>
                <Button DockPanel.Dock="Right" Content="✕" Width="16" Height="16" Padding="0"
                        Margin="6,0,0,0" VerticalAlignment="Center" BorderThickness="0"
                        Background="Transparent" Foreground="{StaticResource Brush.TextSecondary}"
                        ToolTip="关闭会话 (Ctrl+W)"
                        Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                        CommandParameter="{Binding Session.Id}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Error}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="{Binding Session.Title}" VerticalAlignment="Center"
                           FontSize="{StaticResource Font.Size.Body}"
                           ToolTip="{Binding Session.Title}"/>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource Padding.Page}"
          Keyboard.KeyDown="OnKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 模块工具栏（裁剪后，§7.1）：开始/停止（Device 级）| 暂停/清空/导出（焦点会话级） -->
        <DockPanel Grid.Row="0" Margin="{StaticResource Margin.Toolbar}">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <ui:Button Content="{Binding IsCapturing, Converter={StaticResource BoolToCaptureText}, ConverterParameter=停止采集|开始采集}"
                           Command="{Binding ToggleCaptureCommand}"
                           Appearance="{Binding IsCapturing, Converter={StaticResource BoolToAppearance}}"
                           Margin="0,0,10,0" Icon="FluentPlay24"/>
                <ui:Button Content="暂停" Command="{Binding PauseCommand}"
                           Appearance="Secondary" Margin="0,0,10,0" Icon="FluentPause24"
                           ToolTip="冻结当前焦点会话（缓冲继续；其他会话照常刷新）"/>
                <ui:Button Content="清空" Command="{Binding ClearCommand}"
                           Appearance="Secondary" Margin="0,0,10,0" Icon="FluentDelete24"
                           ToolTip="清空当前焦点会话可见区（共享缓冲保留）"/>
                <ui:Button Content="清设备缓冲" Command="{Binding ClearDeviceBufferCommand}"
                           Appearance="Secondary" Margin="0,0,10,0" Icon="FluentEraser24"
                           ToolTip="adb logcat -c 并清空共享缓冲与全部会话可见区"/>
                <ui:Button Content="导出" Command="{Binding ExportCommand}"
                           Appearance="Secondary" Margin="0,0,10,0" Icon="FluentSave24"
                           ToolTip="导出当前焦点会话过滤后的 txt"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button x:Name="NewSessionButton" Content="＋" Width="28" Padding="0"
                           Appearance="Secondary" Click="OnNewSessionClick"
                           ToolTip="新建会话（全部日志 / 按包名 / 按 PID）">
                    <ui:Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="全部日志" Command="{Binding AddAllSessionCommand}"/>
                            <MenuItem Header="按包名…" Command="{Binding AddPackageSessionInteractiveCommand}"/>
                            <MenuItem Header="按 PID…" Command="{Binding AddPidSessionInteractiveCommand}"/>
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>
            </StackPanel>
        </DockPanel>

        <!-- 会话 Tab 栏 + 内容（Xshell 式多会话，M1） -->
        <TabControl x:Name="SessionTabs" Grid.Row="1"
                    ItemsSource="{Binding SessionViewModels}"
                    SelectedItem="{Binding ActiveSession}"
                    ItemTemplate="{StaticResource SessionTabHeader}">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="重命名"
                                          Command="{Binding PlacementTarget.Parent.DataContext.RenameSessionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding Session}"/>
                                <MenuItem Header="关闭"
                                          Command="{Binding PlacementTarget.Parent.DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding Session.Id}"/>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.ItemContainerStyle>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <views:LogSessionPane/>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- 底部状态（§7.4）：采集点 + 缓冲/可见/信号/索引年龄（StatusText 合成） -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{StaticResource Brush.Offline}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                <Setter Property="Fill" Value="{StaticResource Brush.Success}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource Font.Size.Body}"
                       Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
