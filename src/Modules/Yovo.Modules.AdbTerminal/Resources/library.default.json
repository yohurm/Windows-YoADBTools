{
  "version": 1,
  "commands": [
    { "name": "获取设备型号", "category": "通用", "command": "shell getprop ro.product.model" },
    { "name": "获取 Android 版本", "category": "通用", "command": "shell getprop ro.build.version.release" },
    { "name": "获取序列号", "category": "通用", "command": "get-serialno" },
    { "name": "获取设备状态", "category": "通用", "command": "get-state" },
    { "name": "获取电池信息", "category": "通用", "command": "shell dumpsys battery" },
    { "name": "获取屏幕分辨率", "category": "通用", "command": "shell wm size" },
    { "name": "获取屏幕密度", "category": "通用", "command": "shell wm density" },
    { "name": "获取 CPU 信息", "category": "通用", "command": "shell cat /proc/cpuinfo" },
    { "name": "获取内存信息", "category": "通用", "command": "shell cat /proc/meminfo" },
    { "name": "获取已安装应用", "category": "通用", "command": "shell pm list packages" },
    { "name": "重启设备", "category": "通用", "command": "reboot", "timeoutMs": 60000 },
    { "name": "重启到 Recovery", "category": "通用", "command": "reboot recovery", "timeoutMs": 60000 },
    { "name": "重启到 Bootloader", "category": "通用", "command": "reboot bootloader", "timeoutMs": 60000 },
    { "name": "屏幕截图", "category": "通用", "command": "shell \"screencap -p /sdcard/screenshot.png\"" },
    { "name": "获取当前 Activity", "category": "通用", "command": "shell \"dumpsys window | grep mCurrentFocus\"" },
    { "name": "查看日志(最近100行)", "category": "通用", "command": "logcat -t 100" },

    {
      "name": "恢复出厂设置(重启)",
      "category": "Nori产测",
      "command": "shell bdft set -recovery",
      "timeoutMs": 120000,
      "description": "进入 recovery 恢复出厂设置，设备会重启，请谨慎操作",
      "successRegex": "^$|^\\[[^\\]]*\\]\\s*=\\s*\\[[^\\]]*\\]",
      "failureRegex": "args is null or empty|access to the service failed|error|fail"
    },
    {
      "name": "进入产测模式 TestMode",
      "category": "Nori产测",
      "command": "shell bdft write -testmode B",
      "timeoutMs": 60000,
      "successRegex": "^$|^\\[[^\\]]*\\]\\s*=\\s*\\[[^\\]]*\\]",
      "failureRegex": "args is null or empty|access to the service failed|error|fail"
    },
    {
      "name": "进入 USER 模式",
      "category": "Nori产测",
      "command": "shell bdft write -testmode N",
      "timeoutMs": 60000,
      "successRegex": "^$|^\\[[^\\]]*\\]\\s*=\\s*\\[[^\\]]*\\]",
      "failureRegex": "args is null or empty|access to the service failed|error|fail"
    },
    { "name": "重启", "category": "Nori产测", "command": "reboot", "timeoutMs": 60000 },
    {
      "name": "检测当前模式",
      "category": "Nori产测",
      "command": "shell bdft read -testmode",
      "successRegex": "^\\[[^\\]]*\\]\\s*=\\s*\\[[^\\]]*\\]",
      "failureRegex": "args is null or empty|access to the service failed|error|fail"
    },
    {
      "name": "写号[PCBID]",
      "category": "Nori产测",
      "command": "shell bdft write -pcbasn {0}",
      "inputPrompts": ["请输入 PCBID"],
      "timeoutMs": 60000,
      "successRegex": "^$|^\\[[^\\]]*\\]\\s*=\\s*\\[[^\\]]*\\]",
      "failureRegex": "args is null or empty|access to the service failed|error|fail"
    },
    {
      "name": "读号[PCBID]",
      "category": "Nori产测",
      "command": "shell bdft read -pcbasn",
      "successRegex": "^\\[[^\\]]*\\]\\s*=\\s*\\[[^\\]]*\\]",
      "failureRegex": "args is null or empty|access to the service failed|error|fail"
    },
    {
      "name": "写号[SN]",
      "category": "Nori产测",
      "command": "shell bdft write -sn {0}",
      "inputPrompts": ["请输入 SN"],
      "timeoutMs": 60000,
      "successRegex": "^$|^\\[[^\\]]*\\]\\s*=\\s*\\[[^\\]]*\\]",
      "failureRegex": "args is null or empty|access to the service failed|error|fail"
    },
    {
      "name": "读号[SN]",
      "category": "Nori产测",
      "command": "shell bdft read -sn",
      "successRegex": "^\\[[^\\]]*\\]\\s*=\\s*\\[[^\\]]*\\]",
      "failureRegex": "args is null or empty|access to the service failed|error|fail"
    },
    {
      "name": "读软件 HWver",
      "category": "Nori产测",
      "command": "shell bdft read -hwver",
      "successRegex": "^\\[[^\\]]*\\]\\s*=\\s*\\[[^\\]]*\\]",
      "failureRegex": "args is null or empty|access to the service failed|error|fail"
    },
    {
      "name": "写其他信息",
      "category": "Nori产测",
      "command": "shell bdft write -extra {0} {1}",
      "inputPrompts": ["请输入 key", "请输入 value"],
      "timeoutMs": 60000,
      "successRegex": "^$|^\\[[^\\]]*\\]\\s*=\\s*\\[[^\\]]*\\]",
      "failureRegex": "args is null or empty|access to the service failed|error|fail"
    },
    {
      "name": "读取其他信息",
      "category": "Nori产测",
      "command": "shell bdft read -extra {0}",
      "inputPrompts": ["请输入 key"],
      "successRegex": "^\\[[^\\]]*\\]\\s*=\\s*\\[[^\\]]*\\]",
      "failureRegex": "args is null or empty|access to the service failed|error|fail"
    },
    {
      "name": "WiFi MAC 读取",
      "category": "Nori产测",
      "command": "shell bdft read -wfmac",
      "successRegex": "^\\[[^\\]]*\\]\\s*=\\s*\\[[^\\]]*\\]",
      "failureRegex": "args is null or empty|access to the service failed|error|fail"
    },
    {
      "name": "BT MAC 读取",
      "category": "Nori产测",
      "command": "shell bdft read -btmac",
      "successRegex": "^\\[[^\\]]*\\]\\s*=\\s*\\[[^\\]]*\\]",
      "failureRegex": "args is null or empty|access to the service failed|error|fail"
    },
    {
      "name": "基础信息校验 Nand",
      "category": "Nori产测",
      "command": "shell bdft get -emmc",
      "successRegex": "^\\[[^\\]]*\\]\\s*=\\s*\\[[^\\]]*\\]",
      "failureRegex": "args is null or empty|access to the service failed|error|fail"
    },
    {
      "name": "基础信息校验 DDR",
      "category": "Nori产测",
      "command": "shell bdft get -ddr",
      "successRegex": "^\\[[^\\]]*\\]\\s*=\\s*\\[[^\\]]*\\]",
      "failureRegex": "args is null or empty|access to the service failed|error|fail"
    },
    {
      "name": "软件版本号读取(Check ROM Version)",
      "category": "Nori产测",
      "command": "shell bdft get -swv",
      "successRegex": "^\\[[^\\]]*\\]\\s*=\\s*\\[[^\\]]*\\]",
      "failureRegex": "args is null or empty|access to the service failed|error|fail"
    }
  ],
  "groups": [
    {
      "name": "设备信息采集",
      "category": "通用",
      "description": "获取设备的完整系统信息",
      "steps": [
        { "name": "获取型号", "command": "shell getprop ro.product.model" },
        { "name": "获取Android版本", "command": "shell getprop ro.build.version.release" },
        { "name": "获取序列号", "command": "get-serialno" },
        { "name": "获取分辨率", "command": "shell wm size" },
        { "name": "获取电池信息", "command": "shell dumpsys battery", "delayAfterMs": 500 }
      ]
    },
    {
      "name": "重启并等待恢复",
      "category": "通用",
      "description": "重启设备后等待设备重新上线",
      "steps": [
        { "name": "重启设备", "command": "reboot", "timeoutMs": 60000, "delayAfterMs": 30000 },
        { "name": "等待设备上线", "command": "wait-for-device", "timeoutMs": 120000, "delayAfterMs": 5000 },
        { "name": "检查启动完成", "command": "shell getprop sys.boot_completed" }
      ]
    },
    {
      "name": "写入SN",
      "category": "Nori产测",
      "description": "Nori 产测流程: 检查设备 → 进入产测模式 → 写入SN → 查询SN",
      "steps": [
        { "name": "1.检查设备", "command": "get-state", "timeoutMs": 10000 },
        {
          "name": "2.进入产测模式",
          "command": "shell bdft write -testmode B",
          "timeoutMs": 60000,
          "delayAfterMs": 1000,
          "successRegex": "^$|^\\[[^\\]]*\\]\\s*=\\s*\\[[^\\]]*\\]",
          "failureRegex": "args is null or empty|access to the service failed|error|fail"
        },
        {
          "name": "3.写入SN",
          "command": "shell bdft write -sn {0}",
          "timeoutMs": 60000,
          "inputPrompts": ["请输入 SN"],
          "successRegex": "^$|^\\[[^\\]]*\\]\\s*=\\s*\\[[^\\]]*\\]",
          "failureRegex": "args is null or empty|access to the service failed|error|fail"
        },
        {
          "name": "4.查询SN",
          "command": "shell bdft read -sn",
          "timeoutMs": 30000,
          "successRegex": "^\\[[^\\]]*\\]\\s*=\\s*\\[[^\\]]*\\]",
          "failureRegex": "args is null or empty|access to the service failed|error|fail"
        }
      ]
    }
  ]
}
