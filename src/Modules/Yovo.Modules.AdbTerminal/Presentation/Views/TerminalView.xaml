<UserControl x:Class="Yovo.Modules.AdbTerminal.Presentation.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="{StaticResource Font.Family}">

    <!-- 布局: Padding.Page 页面边距；列间距 Margin.Column*；面板间距 PanelGap -->
    <Grid Margin="{StaticResource Padding.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======== 工具栏（整宽，独立于三栏——输入区展开时不挤压） ======== -->
        <DockPanel Grid.Row="0" Margin="{StaticResource Margin.Toolbar}">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <ui:Button Content="命令管理" Command="{Binding OpenCommandManagerCommand}"
                           Appearance="Secondary" Margin="0,0,10,0" Icon="FluentSettings24"/>
                <ui:Button Content="执行命令" Command="{Binding ExecuteCommandCommand}"
                           Appearance="Primary" Margin="0,0,10,0" Icon="FluentPlay24"/>
                <ui:Button Content="执行命令组" Command="{Binding ExecuteGroupCommand}"
                           Appearance="Primary" Margin="0,0,10,0" Icon="FluentPlayCircle24"/>
                <ui:Button Content="清空日志" Command="{Binding ClearLogCommand}"
                           Appearance="Secondary" Icon="FluentDelete24"/>
            </StackPanel>
        </DockPanel>

        <!-- ======== 三栏主布局（列宽全部来自 Size.*） ======== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColLeft" Width="{StaticResource Size.LeftPanel}"
                                  MinWidth="{StaticResource Size.LeftPanelMin}"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="ColLog" Width="*"
                                  MinWidth="{StaticResource Size.LogPanelMin}"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="ColInput" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左栏：单条命令 + 命令组（Grid 行分配，统一弹性） ===== -->
            <Grid Grid.Column="0" Margin="{StaticResource Margin.ColumnLeft}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 单条命令面板（DockPanel：列表吃满弹性高度；底 padding 防裁切 P1-2） -->
                <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="单条命令" Style="{StaticResource SectionTitleStyle}"/>
                        <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding Commands}"
                                 SelectedItem="{Binding SelectedCommand}"
                                 BorderBrush="{StaticResource Brush.ListBorder}" BorderThickness="1"
                                 Background="{StaticResource Brush.ListBg}"
                                 Padding="0,0,0,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItemStyle}"/>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="[输入]" FontSize="{StaticResource Font.Size.Caption}"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource Brush.Warn}" VerticalAlignment="Center"
                                                       Visibility="{Binding RequiresInput, Converter={StaticResource BoolToVisibility}}"
                                                       Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource Font.Size.Body}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}"/> <!-- P2-2：省略号 + ToolTip -->
                                        </StackPanel>
                                        <TextBlock Text="{Binding DisplayCommand}" FontSize="{StaticResource Font.Size.Caption}"
                                                   Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="32"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- 分隔条 -->
                <GridSplitter Grid.Row="1" Height="2" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" ResizeBehavior="PreviousAndNext"
                              Background="{StaticResource Brush.Splitter}" Cursor="SizeNS"/>

                <!-- 命令组面板 -->
                <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="命令组" Style="{StaticResource SectionTitleStyle}"/>
                        <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding GroupCategories}"
                                  SelectedItem="{Binding SelectedGroupCategory}"
                                  Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding CommandGroups}"
                                 SelectedItem="{Binding SelectedGroup}"
                                 BorderBrush="{StaticResource Brush.ListBorder}" BorderThickness="1"
                                 Background="{StaticResource Brush.ListBg}"
                                 Padding="0,0,0,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItemStyle}"/>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Category}" FontSize="{StaticResource Font.Size.Caption}"
                                                       Foreground="{StaticResource Brush.Tag}" FontWeight="Bold"
                                                       Margin="0,0,4,0"
                                                       Visibility="{Binding Category, Converter={StaticResource NullToCollapsed}}"/>
                                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource Font.Size.Body}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}"/> <!-- P2-2 -->
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="{StaticResource Font.Size.Caption}"
                                                   Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="32"/>
                                        <TextBlock Text="{Binding StepCount, StringFormat={}{0} 步}"
                                                   FontSize="{StaticResource Font.Size.Caption}"
                                                   Foreground="{StaticResource Brush.TextTertiary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 分隔条 1 -->
            <GridSplitter Grid.Column="1" Style="{StaticResource SplitterStyle}"/>

            <!-- ===== 中栏：日志 ===== -->
            <Grid Grid.Column="2" Margin="{StaticResource Margin.ColumnMid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 日志面板（VM 集合绑定，级别着色，上限裁剪；P2-1 行宽绑定视口防无限宽测量） -->
                <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Padding="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="执行日志" Style="{StaticResource SectionTitleStyle}"
                                   Margin="{StaticResource Padding.Panel}"/>
                        <Border BorderBrush="{StaticResource Brush.ListBorder}" BorderThickness="0,1,0,0">
                            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding LogEntries}"
                                              FontFamily="{StaticResource Font.Family.Mono}"
                                              FontSize="{StaticResource Font.Size.Caption}"
                                              Margin="4,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock TextWrapping="Wrap" Padding="2,1"
                                                       Width="{Binding ActualWidth, ElementName=LogScroll}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.Error}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.Warn}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Info">
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Message}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- 底部状态 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <ProgressBar Width="100" Height="6"
                                 IsIndeterminate="{Binding IsBusy}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                 Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource Font.Size.Body}"
                               Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- 分隔条 2 -->
            <GridSplitter Grid.Column="3" Style="{StaticResource SplitterStyle}"/>

            <!-- ===== 右栏：参数输入（动态列宽，开关宽度来自 Size.InputPanel） ===== -->
            <Grid Grid.Column="4" Margin="{StaticResource Margin.ColumnRight}">
                <Border Style="{StaticResource PanelBorderStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="参数输入" Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ActiveInputs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding GroupLabel}" FontSize="{StaticResource Font.Size.Caption}"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource Brush.Tag}" Margin="0,0,0,4"
                                                       Visibility="{Binding HasGroupLabel, Converter={StaticResource BoolToVisibility}}"/>
                                            <TextBlock Text="{Binding Label}" FontSize="{StaticResource Font.Size.Caption}"
                                                       Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,3"/>
                                            <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                        FontSize="{StaticResource Font.Size.Body}" MinHeight="30"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
