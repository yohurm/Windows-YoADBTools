<Application x:Class="Yovo.Host.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:conv="clr-namespace:Yovo.Shell.Converters;assembly=Yovo.Shell"
  ShutdownMode="OnMainWindowClose"
>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- UI Token 统一管理（v5 工作台设计系统） -->
        <ResourceDictionary Source="pack://application:,,,/Yovo.Shell;component/Resources/ThemeTokens.xaml"/>
        <!-- Fluent Design 浅色主题（产线工控机明亮环境适配） -->
        <ui:ThemesDictionary Theme="Light" />
        <!-- Fluent 控件默认样式 -->
        <ui:ControlsDictionary />
      </ResourceDictionary.MergedDictionaries>

      <!-- 转换器（全局，各模块视图共享，避免重复声明） -->
      <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
      <conv:NullToCollapsedConverter x:Key="NullToCollapsed"/>
      <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
      <conv:BoolToCaptureTextConverter x:Key="BoolToCaptureText"/>
      <conv:BoolToAppearanceConverter x:Key="BoolToAppearance"/>
      <conv:BoolToTextWrappingConverter x:Key="BoolToTextWrapping"/>
      <conv:IntToVisibilityConverter x:Key="IntToVisibility"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
