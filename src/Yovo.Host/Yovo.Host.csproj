<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>YovoAdbTools</AssemblyName>
    <RootNamespace>Yovo.Host</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Yovo ADB Tools</Product>
    <Description>Yovo ADB Tools — 设备工具工作台（模块化单体）：ADB 命令终端 / 文件管理 / 日志分析</Description>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yovo.Platform\Yovo.Platform.csproj" />
    <ProjectReference Include="..\Yovo.Shell\Yovo.Shell.csproj" />
    <ProjectReference Include="..\Modules\Yovo.Modules.AdbTerminal\Yovo.Modules.AdbTerminal.csproj" />
    <ProjectReference Include="..\Modules\Yovo.Modules.FileManager\Yovo.Modules.FileManager.csproj" />
    <ProjectReference Include="..\Modules\Yovo.Modules.LogAnalyzer\Yovo.Modules.LogAnalyzer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!-- 应用图标（TitleBar 使用） -->
  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <!-- 发布配置：单文件自包含 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
