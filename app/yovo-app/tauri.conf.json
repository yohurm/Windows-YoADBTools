{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YovoAdbTools",
  "mainBinaryName": "YovoAdbTools",
  "version": "0.1.0",
  "identifier": "com.yovo.adbtools",
  "build": {
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../ui build",
    "frontendDist": "../../ui/apps/shell/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Yovo ADB Tools",
        "width": 1200,
        "height": 740,
        "minWidth": 980,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": [
      "../../tools/adb.exe",
      "../../tools/AdbWinApi.dll",
      "../../tools/AdbWinUsbApi.dll"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
