{
  "name": "yohu-ui-workspace",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter @yohu/shell dev",
    "build": "pnpm --filter @yohu/shell build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint:tokens": "node ../scripts/check-ui-tokens.mjs",
    "lint": "pnpm lint:tokens"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "solid-js": "^1.9.5",
    "@tauri-apps/plugin-dialog": "^2.4.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^24.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-solid": "^2.11.6",
    "vitest": "^3.1.0",
    "@tauri-apps/cli": "^2.9.0"
  },
  "workspaces": [
    "packages/*",
    "packages/modules/*",
    "apps/*"
  ]
}
